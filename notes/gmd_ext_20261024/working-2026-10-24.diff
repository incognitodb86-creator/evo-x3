+/**
+ * 2026-10-24 patch: throttled persistence for long walks (prompt recovery).
+ * tick() after each unit of work flushes when `flushEvery` units have
+ * accumulated OR `flushIntervalMs` has elapsed since the last flush;
+ * finish() always flushes whatever is pending. flush errors are swallowed.
+ */
+function createIncrementalPersister({ flush, flushEvery = 50, flushIntervalMs = 30000, now = () => Date.now() } = {}) {
+    let pending = 0;
+    let last = now();
+    let flushes = 0;
+    const doFlush = async () => {
+        pending = 0; last = now(); flushes++;
+        try { await flush(); } catch (e) { /* non-fatal */ }
+    };
+    return {
+        tick: async () => {
+            pending++;
+            if (pending >= flushEvery || now() - last >= flushIntervalMs) await doFlush();
+        },
+        finish: async () => { if (pending > 0) await doFlush(); },
+        get flushes() { return flushes; },
+        get pending() { return pending; }
+    };
+}
