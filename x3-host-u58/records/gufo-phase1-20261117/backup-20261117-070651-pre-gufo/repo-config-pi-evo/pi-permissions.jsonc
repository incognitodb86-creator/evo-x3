{
  // Pi permission policy. Phase B1 rules preserved; Phase B2 (U11, 2026-10-15) adds
  // memory / subagent / ComfyUI-MCP boundaries and the pay/send/delete guard rails.
  // Bash + tool patterns: last matching rule wins, so broad fallbacks come first.
  "defaultPolicy": { "tools": "allow", "bash": "allow", "mcp": "allow", "skills": "allow", "special": "allow" }, // 2026-10-30 Max2 stock-strip (Derrick 5:53 AM): bash+mcp default allow; was ask/deny. Prior note 2026-10-28 9:30 PM CT Max: Derrick wants no approval prompts (yoloMode was not taking effect at runtime); every deny below still wins

  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "allow", // 2026-10-30 Max2 stock-strip (Derrick 5:53 AM): bash re-enabled (was deny, Max CAPA fix 2)
    // community (ALI-163, 2026-10-23 11:49 AM CT, Derrick "Yes, switch Forge to the community permissions (1, 2, 4, 5)"): reads widen to /home/evo/AI/* and
    // ComfyUI custom_nodes source (special.external_directory below).
    // 2026-11-03 ~10:45 AM CT, Derek: "Give yourself permission to edit anything". These two lines were "deny" (community
    // ALI-163, 2026-10-23) and are now "allow", so Pi's file tools may edit/write anywhere under /home/evo/AI. This is the FIRST
    // match, so every later deny in this file still wins; the kept guard rails are re-listed at the end of "tools" below.
    "edit:/home/evo/AI/*": "allow",
    "write:/home/evo/AI/*": "allow",
    "read:/home/evo/.pi/agent/sessions/*": "deny",
    "read:/home/evo/AI/part1-2026-10-15/pi-sessions/*": "deny",
    "read:*/sessions/*": "deny",
    "read:*.log": "deny",
  // 2026-10-20 7:55 PM CT, Derek "do whatever you recommend": bench showed the *.log deny stopped runs. Allow logs in Forge work folders only; re-deny sessions after.
  "read:/home/evo/AI/community/*.log": "allow",
  "read:/home/evo/AI/bench/*.log": "allow",
  "read:/home/evo/AI/forge/ralph-community/logs/*": "allow",
  "read:/home/evo/AI/forge/*.log": "allow",
  // 2026-10-28 7:50 AM CT, Derek via Grok Bot ('Let Pi read finished render folders and their logs under /home/evo/AI/community/runs'): read-only, runs folder only.
  "read:/home/evo/AI/community/runs/*": "allow",
  "read:/home/evo/AI/community/runs/*/*": "allow",
  "read:/home/evo/AI/community/runs/*/*/*": "allow",
  "read:*/sessions/*": "deny",

    // U11 test scratch (edit/write only; deletes are still blocked via bash rules below)

    // --- U11: pi-hermes-memory (background review pinned to local alienpc model, no cloud) ---
    "memory_search": "allow",
    "memory_add": "allow",
    "memory_replace": "allow",
    "memory_remove": "allow",
    "session_search": "allow",
    "skill_manage": "allow",

    // --- U11: pi-subagents delegation (children inherit this policy) ---
    "subagents_enable": "allow",
    "subagent": "allow",
    "bg_wait": "allow",

    // --- U11: ComfyUI MCP via pi-mcp-extension. Read-only allow-list; anything that
    // queues/submits a render is denied (Switchyard owns renders). ---
    "mcp_comfyui_run_workflow": "deny", "mcp_comfyui_regenerate": "deny", "mcp_comfyui_cancel_job": "deny", // 2026-10-30 Max2 stock-strip: blanket mcp_comfyui_* deny removed; render-submit stays denied (GPU lock / run_graph_job.py only)
    // 2026-10-28 ~9:10 AM CT, Derek: "I want pi and our agent/forge to have playwright installed so it can use the Internet and browsers". Microsoft @playwright/mcp 0.0.83 (headless, isolated profile) at /home/evo/AI/community/tools/playwright-mcp. Allow browsing; deny file upload, arbitrary JS and code execution (exfiltration / prompt-injection hazards). Last match wins.
    "mcp_connect": "deny", // 2026-10-28 pi-mcp-extension 1.11.7: model must not start MCP servers itself
    "mcp_playwright_browser_file_upload": "deny",
    "mcp_playwright_browser_evaluate": "deny",
    "mcp_playwright_browser_run_code_unsafe": "deny",
    // 2026-10-28 Derek: "Yes, install both web tools for Pi". open-websearch 2.2.0 (stdio, duckduckgo+startpage only, its page-fetch tools disabled) and mcp-server-fetch 2026.10.24 (blocks private/loopback/file). Results are UNTRUSTED data; never put secrets in queries or URLs.
    // --- ALI-159 (Derrick 2026-10-22 2:41 PM CT, comfy-mcp trial): Comfy-Org comfy-mcp at :10004. Deny all, then allow only
    // read / validate / single run-wait / job status / outputs. Launch, stop, node install, model download, update stay denied. ---
    "mcp_comfy_mcp_launch_comfyui": "deny",
    "mcp_comfy_mcp_stop_comfyui": "deny",
    "mcp_comfy_mcp_restart_comfyui": "deny",
    "mcp_comfy_mcp_install_node": "deny",
    "mcp_comfy_mcp_download_model": "deny",
    "mcp_comfy_mcp_download": "deny",
    "mcp_comfy_mcp_update_comfyui": "deny",
    "mcp_comfy_mcp_switch_comfyui_version": "deny",
    "mcp_comfy_mcp_free_memory": "deny",
    "mcp_comfy_mcp_upload_file": "deny",
    "mcp_comfy_mcp_auth_login": "deny",

