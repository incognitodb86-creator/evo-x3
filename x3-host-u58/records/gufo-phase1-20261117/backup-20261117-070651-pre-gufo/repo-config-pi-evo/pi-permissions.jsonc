    // forgefix 2026-10-20: community Ralph work dir + its loop folder
    "external_directory:/home/evo/AI/community": "allow", // the folder itself (ls/grep on the dir)
    "external_directory:/home/evo/AI/community/*": "allow",
    "external_directory:/home/evo/AI/forge/ralph-community": "allow",
    "external_directory:/home/evo/AI/forge/ralph-community/*": "allow",
    // launchers (ALI-150, 2026-10-21): file tools may reach the Launchers folder and the one plan file outside cwd. Nothing else.
    "external_directory:/home/evo/AI/Launchers": "allow",
    "external_directory:/home/evo/AI/Launchers/*": "allow",
    "external_directory:/home/evo/AI/ORGANIZE_PLAN_2026-10-21.md": "allow",
    // skillspector (ALI-151, 2026-10-21 CT, Derek via Grok Bot: Forge installs NVIDIA SkillSpector and scans read-only, report only): file tools may reach the SkillSpector work folder. Scan targets are read via the powershell tool only (no new external_directory for them).
    "external_directory:/home/evo/AI/security/skillspector": "allow",
    "external_directory:/home/evo/AI/security/skillspector/*": "allow",
    // readme (ALI-163, 2026-10-23 11:07 AM CT, Derrick "Yes do it"): file tools may open custom_nodes/**/README*.md only (edit/write denied in tools). Nothing else in HardcoreNSFW-TestRuntime.
    "external_directory:/home/evo/AI/comfy-alienpc/custom_nodes/*/README*.md": "allow",
    "external_directory:/home/evo/AI/comfy-alienpc/custom_nodes/*/README*/*": "deny", // README* must be the file, not a folder
    // community (ALI-163, 2026-10-23 11:49 AM CT, Derrick "Yes, switch Forge to the community permissions (1, 2, 4, 5)"): file tools may READ all of /home/evo/AI and the
    // ComfyUI custom_nodes source (edit/write stay denied in tools above). Secret and finance paths stay blocked (listed last so they win; the guard also blocks them for Forge).
    "external_directory:/home/evo/AI": "allow",
    "external_directory:/home/evo/AI/*": "allow",
    "external_directory:/home/evo/AI/comfy-alienpc/custom_nodes": "allow",
    "external_directory:/home/evo/AI/comfy-alienpc/custom_nodes/*": "allow",
    // ownskills (2026-10-28 1:35 PM CT, Derek: "Dont restrict pi from editing its own skills"): file tools may reach Pi's own skills folder outside cwd (edit/write allow is in tools above). auth.json and sessions floors below still win.
    "external_directory:/home/evo/.pi/agent/skills": "allow",
    "external_directory:/home/evo/.pi/agent/skills/*": "allow",
    // 2026-11-08 Derek GO (Sydney chat review 2026-11-07, ask 1): the talk lane may use its own file tools on its own lane folder. Measured: every read/edit of the lane AGENTS.md, its lane skills and its own notes returned the hard external-directory denial, and the 2026-11-07 review loop spent 14 extra calls on cat/python workarounds. The secret guard rails below (.env, .key, .pem, rclone, sessions, auth.json) are listed after this rule and still win.
    "external_directory:*/.env*": "deny",
    "external_directory:*.key": "deny",
    "external_directory:*.pem": "deny",
    "external_directory:*rclone*": "deny",
    "external_directory:*/sessions/*": "deny",
    "external_directory:*/pi-sessions/*": "deny",
    "external_directory:*/.git/config": "deny",
    "external_directory:/home/evo/.pi/agent/auth.json": "deny",
  }
}
