#!/usr/bin/env bash
# Nightly stale worktree cleanup (L3, unified plan e0c446f).
# For each worktree under $WORKTREES_DIR older than $MAX_AGE_DAYS (default 7), save git status + git diff
# to $RUNS_DIR, then remove and prune the worktree. Set DRY_RUN=1 to preview without removing.
set -euo pipefail

WORKTREES_DIR="${WORKTREES_DIR:-$HOME/AI/_worktrees}"
RUNS_DIR="${RUNS_DIR:-$HOME/AI/_runs}"
MAX_AGE_DAYS="${MAX_AGE_DAYS:-7}"
DRY_RUN="${DRY_RUN:-0}"

[ -d "$WORKTREES_DIR" ] || exit 0
mkdir -p "$RUNS_DIR"

STAMP="$(date +%Y%m%d-%H%M%S)"
REPORT="$RUNS_DIR/stale-worktrees-${STAMP}.log"
COUNT=0

while IFS= read -r wt; do
  [ -n "$wt" ] || continue
  name="$(basename "$wt")"
  COUNT=$((COUNT + 1))
  {
    echo "=== stale worktree: $wt ==="
    git -C "$wt" status --short 2>&1 || true
    echo "--- diff ---"
    git -C "$wt" diff 2>&1 || true
  } >> "$REPORT"
  if [ "$DRY_RUN" = "1" ]; then
    echo "DRY_RUN: would remove $wt" >> "$REPORT"
    continue
  fi
  common_dir="$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null || true)"
  if [ -n "$common_dir" ] && [ -d "$common_dir" ]; then
    parent_repo="$(dirname "$(realpath "$common_dir")")"
    git -C "$parent_repo" worktree remove --force "$wt" >> "$REPORT" 2>&1 || true
    git -C "$parent_repo" worktree prune >> "$REPORT" 2>&1 || true
  else
    echo "SKIP remove (not a git worktree): $wt" >> "$REPORT"
  fi
done < <(find "$WORKTREES_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +"$MAX_AGE_DAYS" 2>/dev/null || true)

if [ "$COUNT" -gt 0 ]; then
  echo "cleaned=$COUNT report=$REPORT"
else
  rm -f "$REPORT"
fi
