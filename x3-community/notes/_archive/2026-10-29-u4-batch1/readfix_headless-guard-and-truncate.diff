 const COMFY_BUSY_REASON = "a render is running (gpu_guard.ps1 BUSY: ComfyUI queue, render process or GPU lock), so ComfyUI is not stopped or restarted. Wait for the job to finish (python C:/AI/community/scripts/comfy_ctl.py status), then retry.";
 
+// readfix 2026-10-23 (ALI-163, Derrick 11:09 AM CT "Yes don't be so restrictive to forge wtf"): pi-permissions now lets bash run
+// `python -c "<code>"` (code may span lines and contain ';') and read commands ending in `2>/dev/null` / `2>$null`. pi's wildcards can't
+// see quotes, so the shape is checked here: Forge sessions get exactly one quoted -c argument (no $( or backtick inside double quotes) and
+// nothing after it but the stderr redirect; non-Forge sessions keep the old floor (no ';', newline or '>/' in those commands).
+const STDERR_NULL = /\s+2>\s*(?:\/dev\/null|\$null)\s*$/;
+const PY_C = /^\s*python3?(?:\.exe)?\s+-c\s+/i;
+export interface RelaxShape { wasDenied: boolean; bad: string | null }
+export function relaxedShape(command: string): RelaxShape | null {
+	const hasNull = STDERR_NULL.test(command);
+	const body = command.replace(STDERR_NULL, "");
+	const m = PY_C.exec(body);
+	if (m) {
+		const rest = body.slice(m[0].length);
+		const wasDenied = /[;\n\r]|>\/|>\s*\$null/.test(command);
+		const q = rest[0];
+		if (q !== '"' && q !== "'") return { wasDenied, bad: "python -c needs its code as one quoted argument (\"...\" or '...')." };
+		let k = 1;
+		if (q === "'") {
+			k = rest.indexOf("'", 1);
+		} else {
+			for (; k < rest.length; k++) {
+				const c = rest[k];
+				if (c === "\\") { k++; continue; }
+				if (c === "`" || (c === "$" && rest[k + 1] === "(")) return { wasDenied, bad: "no $( ) or backtick inside python -c \"...\" (bash would run it); use single quotes or a .py file." };
+				if (c === '"') break;
+			}
+			if (k >= rest.length) k = -1;
+		}
+		if (k < 0) return { wasDenied, bad: "python -c code has no closing quote." };
+		if (rest.slice(k + 1).trim() !== "") return { wasDenied, bad: "nothing may follow python -c \"...\" except 2>/dev/null (no ; && | > or a second command)." };
+		return { wasDenied, bad: null };
+	}
+	if (hasNull) {
+		const bad = /[;&|`<>\n\r]|\$\(/.test(body) ? "only one plain read command may end in 2>/dev/null (no ; && | > < or $( before it)." : null;
+		return { wasDenied: /2>\s*\/dev\/null/.test(command), bad };
+	}
+	return null;
+}
