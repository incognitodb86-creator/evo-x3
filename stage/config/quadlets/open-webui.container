# Open WebUI — system Quadlet for EVO-X3
# Official source: https://docs.openwebui.com/getting-started/quick-start/ (Podman Quadlets, accessed 2026-11-15 CT)
# Adaptations (see records/U22-open-webui-20261115.md):
# - System unit (not rootless) so /etc/evo-x3/openwebui.env can stay root 0600
# - Network=host + official HOST=127.0.0.1 and PORT=3000 so the UI binds
#   loopback only and can reach llama-swap on 127.0.0.1:8080 (rootful Podman
#   cannot reach host loopback through pasta / host.containers.internal)
# Secrets stay in EnvironmentFile; do not put keys in this unit.
# No GPU devices. Do not set USE_CUDA_DOCKER.

[Unit]
Description=Open WebUI (tailnet chat UI)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/open-webui/open-webui:main
ContainerName=open-webui
Network=host
Volume=open-webui:/app/backend/data
EnvironmentFile=/etc/evo-x3/openwebui.env
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=ENABLE_OLLAMA_API=false
Environment=ENABLE_OPENAI_API=true
Environment=OPENAI_API_BASE_URL=http://127.0.0.1:8080/v1
Environment=ENABLE_SIGNUP=true
Environment=DEFAULT_USER_ROLE=pending
Environment=WEBUI_URL=https://evo-x3-1.tailf242b2.ts.net:8443

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
