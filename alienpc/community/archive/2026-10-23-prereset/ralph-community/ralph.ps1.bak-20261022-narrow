        if($reuse){ JobResult $id @{ ok = $true; kind = $kind; rc = 0; wall_min = 0; started = $t0.ToString('s'); outputs = @("$out.md", "$out.json"); note = $reuse; log = '' }; continue }
        $argv = @('-u', $Rev, 'rank', '--preset', 'p6', '--judge', $judge, '--out', $out)
      }
      elseif($np -ge 1 -and $np -le 3){
        $out = "$Revs\$id\review"; $argv = @('-u', $Rev, 'compare', '--judge', $judge, '--out', $out)
        foreach($pp in @($j.pairs)){ $pa, $ch = "$pp" -split '=', 2; if($pa -notmatch $spec -or $ch -notmatch $spec){ $argv = $null; break }; $argv += @('--pair', "$pa=$ch") }
      } elseif($nc -ge 2 -and $nc -le 5){
        $out = "$Revs\$id\review"; $argv = @('-u', $Rev, 'rank', '--judge', $judge, '--out', $out)
        foreach($cc in @($j.cands)){ if("$cc" -notmatch $spec){ $argv = $null; break }; $argv += @('--cand', "$cc") }
      }
      if($null -eq $argv){ JobResult $id @{ ok = $false; note = 'refused: review job needs preset "p6", 1-3 pairs "PARENT=CHILD" or 2-5 cands (p6_/p7_ run names, optional :segN)' }; continue }
      New-Item -ItemType Directory -Force (Split-Path $out) | Out-Null
      $rc = RunProc $py $argv $id 120
      $ok = ($rc -eq 0) -and (Test-Path -LiteralPath "$out.json"); $outs = @("$out.md", "$out.json")
      # judge-20261021 (backup ralph.ps1.bak-20261021-judge): the note used to be a fixed exit-code legend ("0 ok, 2 input error, ...
      # 5 judge replies unusable") on EVERY review, which read like failure counts. Now: meaning of this rc + real judge counts from
      # review.json; ok also needs >= 1 usable judge reply.
      $rcWhy = switch([int]$rc){ 0 {'ok'} 2 {'input error'} 3 {'refused: GPU busy/lock/adults-only guard'} 4 {'checkshots rejected'} 5 {'judge failure: too many judge replies unusable'} default {'unexpected exit'} }
      $stat = ''
      if(Test-Path -LiteralPath "$out.json"){
        try {
          $rj = [IO.File]::ReadAllText("$out.json") | ConvertFrom-Json; $good = [int]$rj.asks - [int]$rj.judge_failures
          $stat = "; judge $($rj.judge): $good/$($rj.asks) replies usable ($($rj.calls) calls)"
          if($rj.verdicts){ $stat += '; verdicts ' + (@($rj.verdicts | ForEach-Object { "$($_.child)=$($_.verdict)" }) -join ', ') }
          elseif($rj.ranking){ $stat += '; rank ' + (@($rj.ranking | ForEach-Object { "$($_.rank). $($_.name) $($_.composite)" }) -join ' | ') }
          if((-not $rj.model_used) -or $good -le 0){ $ok = $false; $stat += ' -> NOT ok (0 usable judge replies)' }
        } catch { $ok = $false; $stat = "; review.json unreadable: $($_.Exception.Message)" }
      }
      $note = "p6_review rc=$rc ($rcWhy)$stat"
    } elseif($kind -eq 'graph' -or $kind -eq 'dip'){
      # ali160: ALI-147 arms. graph = one prepared API graph runs\<id>\request.api.json; dip = CPU ffmpeg dip join. The harness runs them, never the model.
      if($id -notmatch '^ali147_pool_[a-z0-9]+_s\d+$'){ JobResult $id @{ ok = $false; note = 'refused: graph/dip ids are ali147_pool_<arm>_s<seed>' }; continue }
      $run = "$C\runs\$id"
      if($kind -eq 'graph'){
        if(-not (Test-Path -LiteralPath "$run\request.api.json")){ JobResult $id @{ ok = $false; note = "refused: missing $run\request.api.json" }; continue }
        if(Test-Path -LiteralPath "$run\$id.mp4"){ JobResult $id @{ ok = $false; note = "refused: $run\$id.mp4 already exists (arm already rendered)" }; continue }
        $mins = [math]::Min([math]::Max([int]$j.minutes, 30), 180)
        $argv = @('-u', $GJ, $run, $id, '--frames', "$([int]$j.frames)", '--frames-tol', "$([int]$j.frames_tol)", '--timeout', "$([int]($mins * 20))", '--max-redo', '2')
        $rc = RunProc $DPy $argv $id $mins
        $ok = ($rc -eq 0); $outs = @("$run\status.log", "$run\objective.json", "$run\$id.mp4", "$run\${id}_stills_contact.png")
        $rcWhy = switch([int]$rc){ 0 {'ok'} 2 {'static check failed, see status.log'} 3 {'adults-only guard'} 4 {'ComfyUI down'} 5 {'objective failure after 2 redos: STUCK, flagged for Derrick'} default {'unexpected exit'} }
        $note = "run_graph_job rc=$rc ($rcWhy)"
      } else {
        if(Test-Path -LiteralPath "$run\dipblack.mp4"){ JobResult $id @{ ok = $false; note = "refused: $run\dipblack.mp4 already exists" }; continue }
        $rc = RunProc $DPy @('-u', $DJ, $run) $id 30
        $ok = ($rc -eq 0); $outs = @("$run\dip.log", "$run\ffmpeg_cmd.txt", "$run\dipblack.mp4", "$run\dipwhite.mp4", "$run\base_reenc.mp4"); $note = "dip_join rc=$rc"
      }
    } else { JobResult $id @{ ok = $false; note = "refused: unknown kind '$kind' (render | review | graph | dip)" }; continue }
    $min = ((Get-Date) - $t0).TotalMinutes; BudgetAdd $min
    JobResult $id @{ ok = $ok; kind = $kind; rc = $rc; wall_min = [math]::Round($min, 1); started = $t0.ToString('s'); outputs = $outs; note = $note; log = "$Jobs\$id.out" }
  }
}
