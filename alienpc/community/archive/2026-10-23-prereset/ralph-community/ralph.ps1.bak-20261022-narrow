function PermsOk($path){
  $t = [IO.File]::ReadAllText($path); $h = (@(G -C $K show HEAD:ralph.ps1) -join "`n")
  $blk = { param($s) $m = [regex]::Match($s, '(?s)# PERMS-BEGIN.*# PERMS-END'); if($m.Success){ ($m.Value -replace "`r", '') } else { $null } }
  $a = & $blk $t; $b = & $blk $h
