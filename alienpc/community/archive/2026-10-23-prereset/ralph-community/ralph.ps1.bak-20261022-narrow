function ReuseRanking([string]$f){
  # p7lock 2026-10-20: a P6 ranking from overnight_chain.ps1 is reused when it is < 18 h old, model-judged with the CURRENT rubric of
  # p6_review.py, covers 5 videos, has <= 25% judge failures and its .md exists. Anything else (or any error) = $null = judge again.
  try{
    if(-not (Test-Path -LiteralPath $f)){ return $null }
    if((Get-Item -LiteralPath $f).LastWriteTime -lt (Get-Date).AddHours(-18)){ return $null }
    $md = $f -replace '\.json$', '.md'; if(-not (Test-Path -LiteralPath $md)){ return $null }
    $o = [IO.File]::ReadAllText($f) | ConvertFrom-Json
    $rv = [regex]::Match([IO.File]::ReadAllText($Rev), '(?m)^RUBRIC_VERSION\s*=\s*"([^"]+)"').Groups[1].Value
    $rk = @($o.ranking)
    if($o.model_used -ne $true -or -not $rv -or "$($o.rubric)" -ne $rv -or $rk.Count -ne 5){ return $null }
    if([double]$o.asks -le 0 -or ([double]$o.judge_failures / [double]$o.asks) -gt 0.25){ return $null }
    return "reused runs\P6_RANKING.json from $($o.when) (overnight_chain pre-run; rubric $rv, judge $($o.judge), $($o.judge_failures)/$($o.asks) judge failures); no GPU time used"
  } catch { return $null }
}
