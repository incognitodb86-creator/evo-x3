function KScope($chg, $n){
  # scope check for ralph-community: only TASKS.md, STOP_RALPH, notes\* may change. New untracked *.bak* files (Forge backup copies)
  # are moved to _removed and logged (not a violation); any other new file is reported; tracked changes are restored from git.
  $v = @()
  foreach($ch in @($chg | Where-Object { $_.InK })){
    $rel = $ch.Path -replace '/','\'
    if($rel -eq 'TASKS.md' -or $rel -eq 'STOP_RALPH' -or $rel -like 'notes\*'){ continue }
    if($rel -eq 'ralph.ps1' -and $ch.Code -ne '??' -and (PermsOk $ch.Full)){ Log "iter $n note: Forge edited ralph.ps1 (harness fix; permission block unchanged)"; continue }
    if($ch.Code -eq '??' -and (Split-Path $rel -Leaf) -match '(?i)\.bak' -and (Test-Path -LiteralPath $ch.Full -PathType Leaf)){
      $rd = "$K\_removed"; New-Item -ItemType Directory -Force $rd | Out-Null
      $dst = Join-Path $rd (Split-Path $rel -Leaf); if(Test-Path -LiteralPath $dst){ $dst = "$dst-$(Get-Date -f 'yyyyMMdd-HHmmss')" }
      Move-Item -LiteralPath $ch.Full -Destination $dst
      [IO.File]::AppendAllText("$rd\MOVED.txt", "$(Get-Date -f s) ralph.ps1 iter ${n}: moved $($ch.Full) -> $dst (backup copy made by Forge; the harness commits to git, backups are not needed)`r`n", $Enc)
      Log "iter $n note: Forge made a backup copy $($ch.Full); moved to $dst (harmless, not a scope violation)"
      continue
    }
    if($ch.Code -eq '??'){ $v += "new file outside scope (left in place, review it): $($ch.Full)" }
    else { $null = G -C $K checkout '--' $ch.Path; $v += "out-of-scope change restored from git: $($ch.Full) (git rc=$script:GitRc)" }
  }
  $v
}
