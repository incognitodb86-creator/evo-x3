[Unit]
Description=H3 Daily read-only fleet morning status via ntfy (0 swaps, zero secrets)
After=network-online.target

[Service]
Type=oneshot
Environment=EVO_NTFY_TOKEN_FILE=%h/.config/evo-x3/ntfy-x3.token
Environment=EVO_NTFY_URL=https://qnap.tailf242b2.ts.net:8447/renders-a7gma8xg
Environment=EVO_GUFO_URL=http://127.0.0.1:8080/running
Environment=EVO_ALIEN_URL=http://alienpc.tailf242b2.ts.net:8447/health
Environment=EVO_JC_LOG=/home/evo/AI/pixlstash-tagging/runner-stdout.log
Environment=EVO_RUNS_DIR=/home/evo/AI/community/runs
ExecStart=/usr/bin/flock -n /tmp/evo-morning-status.lock /usr/bin/python3 -c "exec(chr(10).join([ \
  '''import json, os, pathlib, shutil, urllib.request''', \
  '''E = os.environ''', \
  '''try:''', \
  '''    with urllib.request.urlopen(E['EVO_GUFO_URL'], timeout=3) as r: gufo = 'ok(' + str(len(json.loads(r.read()).get('running', []))) + ' loaded)' ''', \
  '''except Exception: gufo = 'down' ''', \
  '''try:''', \
  '''    with urllib.request.urlopen(E['EVO_ALIEN_URL'], timeout=3) as r: alien = 'http-' + str(r.status)''', \
  '''except Exception: alien = 'unreachable' ''', \
