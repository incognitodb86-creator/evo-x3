# plan-v32 P4.7 (Max Architect 2026-11-19): AlienPC renders share, rw since t2555 (one renders home for both machines), for sync-renders -> /srv/renders.
[Unit]
Description=QNAP renders share (rw, evo; X3 writes upscaled finals into runs/, t2555) at /mnt/qnap/renders
After=network-online.target
Wants=network-online.target

[Mount]
What=//192.168.0.147/renders
Where=/mnt/qnap/renders
Type=cifs
Options=credentials=/etc/evo-x3/qnap-derek.cred,vers=3.0,uid=evo,gid=evo,file_mode=0644,dir_mode=0755,_netdev,nofail
