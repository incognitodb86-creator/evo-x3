-
-
-def detect_revisions(path: str) -> dict:
-    """Detect tracked changes and comments by scanning the raw XML parts."""
-    markers = {"insertions": b"<w:ins ", "deletions": b"<w:del ",
-               "format_changes": b"<w:rPrChange"}
