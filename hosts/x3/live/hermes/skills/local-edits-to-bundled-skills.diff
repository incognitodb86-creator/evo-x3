-### Manual Frame Export (More Control)
-
-```javascript
-let recording = false;
-let frameNum = 0;
-const TOTAL_FRAMES = 300;
-
-function keyPressed() {
-  if (key === 'r') recording = !recording;
-}
-
-function draw() {
-  // ... render frame ...
-
-  if (recording) {
-    saveCanvas('frame-' + nf(frameNum, 4), 'png');
-    frameNum++;
-    if (frameNum >= TOTAL_FRAMES) {
-      recording = false;
-      noLoop();
-      console.log('Recording complete: ' + frameNum + ' frames');
-    }
-  }
-}
