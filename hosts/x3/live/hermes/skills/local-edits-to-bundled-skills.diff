-```javascript
-function setup() {
-  createCanvas(1920, 1080, SVG);  // SVG renderer
-  noLoop();
-}
-
-function draw() {
-  // Only vector operations work (no pixel ops, no blendMode)
-  stroke(0);
-  noFill();
