[Unit]
Description=Hermes WebUI - Browser Interface for Hermes Agent
After=network-online.target hermes-gateway.service
Wants=network-online.target hermes-gateway.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/evo/hermes-webui/bootstrap.py --no-browser --foreground
WorkingDirectory=/home/evo/hermes-webui
Environment="HERMES_HOME=/home/evo/.hermes"
Environment="HERMES_WEBUI_HOST=127.0.0.1"
Environment="HERMES_WEBUI_PORT=8787"
Environment="HERMES_WEBUI_CHAT_BACKEND=gateway"
Environment="HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642"
Environment="HERMES_WEBUI_GATEWAY_USE_RUNS_API=true"
Environment="HERMES_API_URL=http://127.0.0.1:8642"
Environment="MEDIA_ALLOWED_ROOTS=/home/evo/AI/5slock/libraries"
EnvironmentFile=%h/.config/evo-x3/llm.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
