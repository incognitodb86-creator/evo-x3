        0
      ]
    }
  },
  "noise": {
    "_meta": {},
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 51083601
    }
  },
  "refapply": {
    "_meta": {
      "title": "Apply H3 RefMod (retention 1.0 = fully_preserved)"
    },
    "class_type": "MiniMaxH3RefModApply",
    "inputs": {
      "conditioning": [
        "c0",
        0
      ],
      "curve_direction": "constant",
      "curve_shape": "linear",
      "curve_value": 1.0,
      "mods": [
        "refmods",
        0
      ],
      "override": false,
      "retention": 1.0,
      "scramble_seed": 0
    }
  },
  "refmods": {
    "_meta": {
      "title": "Load H3 RefMods (one identity RefMod)"
    },
    "class_type": "MiniMaxH3RefModsLoader",
    "inputs": {
      "copies_1": 1,
      "copies_2": 1,
      "copies_3": 1,
      "copies_4": 1,
      "copies_5": 1,
      "copies_6": 1,
      "copies_7": 1,
      "copies_8": 1,
      "max_total_tokens": 0,
      "mod_1": "(none)",
      "mod_2": "(none)",
      "mod_3": "(none)",
      "mod_4": "(none)",
      "mod_5": "(none)",
      "mod_6": "(none)",
      "mod_7": "(none)",
      "mod_8": "(none)",
      "show_info": false,
      "strength_1": 1.0,
      "strength_2": 1.0,
      "strength_3": 1.0,
      "strength_4": 1.0,
      "strength_5": 1.0,
      "strength_6": 1.0,
      "strength_7": 1.0,
      "strength_8": 1.0
    }
  },
