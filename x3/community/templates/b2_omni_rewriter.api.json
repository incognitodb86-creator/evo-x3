        0
      ],
      "height": 1344,
      "length": 192,
      "prompt": [
        "rewriter",
        0
      ],
      "ref_image_size": "match",
      "vae": [
        "vvae",
        0
      ],
      "width": 768
    }
  },
  "clip": {
    "_meta": {},
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "device": "default",
      "type": "minimax"
    }
  },
  "dec_a": {
    "_meta": {},
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "s0_sep",
        1
      ],
      "vae": [
        "avae",
        0
      ]
    }
  },
  "dec_v": {
    "_meta": {},
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "s0_sep",
        0
      ],
      "vae": [
        "vvae",
        0
      ]
    }
  },
  "ksel": {
    "_meta": {},
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "m_attn": {
    "_meta": {},
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "attention": "comfy kitchen attention",
      "model": [
        "unet",
        0
      ]
    }
  },
  "m_shift": {
    "_meta": {},
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "m_vsa",
        0
      ],
      "shift_audio": 3.0,
      "shift_video": 12.0
    }
  },
  "m_vsa": {
    "_meta": {},
    "class_type": "BlockSparseAttention",
    "inputs": {
      "dense_blocks": "0,1",
      "end_percent": 1.0,
