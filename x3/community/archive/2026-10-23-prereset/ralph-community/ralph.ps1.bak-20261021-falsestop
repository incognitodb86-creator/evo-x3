#  - P7 job runner: the model may only REQUEST GPU work via C:\AI\community\p7\JOB_REQUEST.json; the harness runs it between iterations
#    (render = batch_queue.py --no-upload, review = p6_review.py), with GPU-minute (-GpuCapMin) and job (-JobMax) caps. See p7\KNOBS.md.
#  - GuardWait also samples nvidia-smi: utilisation > -UtilMax % with gpu_guard IDLE (e.g. a llama-swap bench) counts as BUSY.
#  - harness-owned P7 files (review/batch scripts, gpu_guard/gpu_lock, KNOBS.md, P6_RANKING.*, p7\jobs, p7\reviews, budget) are hashed
#    before each iteration; a change by the model is restored from wfsnap\prot_NN and stops the loop (scope).
param([int]$Max=10,[int]$TimeoutMin=20,[int]$GuardWaitMin=180,[int]$GuardPollSec=120,[int]$GpuCapMin=360,[int]$JobMax=16,[int]$UtilMax=30)
$R='C:\Users\derek\5slock'; $K='C:\Users\derek\5slock\ralph-community'; $L="$K\logs"; $C='C:\AI\community'
$Guard='C:\AI\director\scripts\gpu_guard.ps1'; $WF='C:\Users\derek\HardcoreNSFW-TestRuntime\ComfyUI\user'; $Snap="$K\wfsnap"; $Sess="$K\sessions"; $Agents="$R\AGENTS.md"
Set-Location $R; New-Item -ItemType Directory -Force $L, $Sess | Out-Null
function Log($m){ "$(Get-Date -f s) $m" | Add-Content "$L\ralph.log" }
function Stop-Ralph($m){ [IO.File]::WriteAllText("$K\STOP_RALPH", "$(Get-Date -f s) ralph.ps1: $m`r`n", (New-Object Text.UTF8Encoding $false)); Log "STOP_RALPH: $m" }
function Open { @(Select-String -Path "$K\TASKS.md" -Pattern '^\s*- \[ \]').Count }
function Ticks { @(Select-String -Path "$K\TASKS.md" -Pattern '^\s*- \[x\]').Count }
function FHash($p){ if(Test-Path -LiteralPath $p){ (Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash } else { 'missing' } }
function G { $o = & git @args 2>&1 | ForEach-Object { "$_" }; $script:GitRc = $LASTEXITCODE; $o }
function Commit($msg){ foreach($repo in $C, $K){ $null = G -C $repo add -A; $null = G -C $repo commit -q --allow-empty -m $msg; if($script:GitRc -ne 0){ Log "git commit failed in $repo ($msg)" } } }
function Changed($repo){
  foreach($line in @(G -C $repo status --porcelain --untracked-files=all)){
    if($line.Length -lt 4){ continue }
    $rp = $line.Substring(3); if($rp -match ' -> '){ $rp = ($rp -split ' -> ')[-1] }
    [pscustomobject]@{ Code = $line.Substring(0,2); Path = $rp.Trim('"') }
  }
}
function WfFiles { if(Test-Path -LiteralPath $WF){ @(Get-ChildItem -LiteralPath $WF -Recurse -File -Filter *.json -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch '\\__manager\\' }) } else { @() } }
function WfHashes { $h=@{}; foreach($f in WfFiles){ $h[$f.FullName] = (Get-FileHash -LiteralPath $f.FullName -Algorithm SHA256).Hash }; $h }
function WfSnapshot($n){
  $d = "$Snap\iter_$n"
  foreach($f in WfFiles){ $dst = Join-Path $d $f.FullName.Substring($WF.Length).TrimStart('\'); New-Item -ItemType Directory -Force (Split-Path $dst) | Out-Null; Copy-Item -LiteralPath $f.FullName -Destination $dst -Force }
  $d
}
function GuardWait {
  $t0 = Get-Date; $last = ''
  while($true){
    $o = (& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $Guard 2>&1 | Out-String).Trim(); $rc = $LASTEXITCODE
    if($rc -eq 0){
      $u = GpuUtil
      if($u -le $UtilMax){ if($last){ Log "gpu guard: IDLE after $([int]((Get-Date)-$t0).TotalMinutes) min wait" }; return $true }
      $o = "BUSY: GPU utilisation {0:N0}% while gpu_guard says IDLE (work the guard cannot see, e.g. a llama-swap bench)" -f $u; $rc = 1
    }
    $why = @($o -split "`r?`n" | Where-Object { $_ -match '^BUSY' })[0]; if(-not $why){ $why = "guard rc=$rc $o" }
    if($why -ne $last){ Log "refused: render running ($why)"; $last = $why }
    if(((Get-Date)-$t0).TotalMinutes -ge $GuardWaitMin){ Log "refused: GPU still busy after $GuardWaitMin min; exiting ($why)"; return $false }
    Start-Sleep -Seconds $GuardPollSec
  }
}
# --- P7 GPU job runner (p6opt 2026-10-20, Derek-requested prep; backup ralph.ps1.bak-20261020-p6opt) ---
# The loop's LLM and ComfyUI share one exclusive llama-swap group: loading the LLM kills a render. So the model NEVER starts GPU work.
# It writes C:\AI\community\p7\JOB_REQUEST.json; after pi has exited and the iteration passed every check, the harness validates it
# and runs each job synchronously (gpu_guard + GPU-utilisation wait first; renders only through batch_queue.py --no-upload; reviews only
# through p6_review.py), writes p7\jobs\<id>.result.json, tracks GPU minutes against -GpuCapMin, and only then starts the next iteration.
$P7="$C\p7"; $Req="$P7\JOB_REQUEST.json"; $Jobs="$P7\jobs"; $Revs="$P7\reviews"; $Budget="$L\p7_budget.json"; $LSU='http://127.0.0.1:8080'
$CPy='C:\Users\derek\HardcoreNSFW-TestRuntime\ComfyUI\.venv\Scripts\python.exe'; $Rev="$C\scripts\p6_review.py"; $BQ="$C\scripts\batch_queue.py"
# harness-owned files the model must not change (restored from a per-iteration snapshot + STOP_RALPH); plus every *.json/*.md in p7\jobs and p7\reviews
$Prot=@("$C\scripts\p6_review.py","$C\scripts\tests\test_p6_review.py","$C\scripts\batch_queue.py","$C\scripts\comm.py","$C\scripts\prompt_writer.py",
        "$P7\KNOBS.md",$Guard,'C:\AI\director\scripts\gpu_lock.ps1',"$C\runs\P6_RANKING.md","$C\runs\P6_RANKING.json",$Budget)
$Enc = New-Object Text.UTF8Encoding $false; $script:JobStop = $false
New-Item -ItemType Directory -Force $Jobs, $Revs | Out-Null
function WriteJson($path, $obj){ [IO.File]::WriteAllText($path, ($obj | ConvertTo-Json -Depth 6), $Enc) }
function ProtFiles {
  $fs = @($Prot | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf })
  foreach($d in $Jobs, $Revs){ if(Test-Path -LiteralPath $d){ $fs += @(Get-ChildItem -LiteralPath $d -Recurse -File -ErrorAction SilentlyContinue | Where-Object { ($_.Extension -eq '.json' -or $_.Extension -eq '.md') -and $_.FullName -notmatch '_work\\' } | ForEach-Object { $_.FullName }) } }
  $fs
}
function ProtSnapshot($n){
  $d = "$Snap\prot_$n"; $h = @{}
  foreach($f in ProtFiles){ $h[$f] = (Get-FileHash -LiteralPath $f -Algorithm SHA256).Hash; $dst = Join-Path $d ($f -replace '^([A-Za-z]):', '$1'); New-Item -ItemType Directory -Force (Split-Path $dst) | Out-Null; Copy-Item -LiteralPath $f -Destination $dst -Force }
  @{ Dir = $d; H = $h }
}
function ProtCheck($snap){
  $v = @(); $now = @{}; foreach($f in ProtFiles){ $now[$f] = (Get-FileHash -LiteralPath $f -Algorithm SHA256).Hash }
  foreach($f in @($snap.H.Keys)){
    if($now[$f] -ne $snap.H[$f]){ $src = Join-Path $snap.Dir ($f -replace '^([A-Za-z]):', '$1'); Copy-Item -LiteralPath $src -Destination $f -Force; $v += "harness-owned file changed/deleted by the model, restored: $f" }
  }
  foreach($f in @($now.Keys)){ if(-not $snap.H.ContainsKey($f)){ $v += "new file in a harness-owned P7 folder (left in place, review it): $f" } }
  $v
}
function GpuUtil {
  $v = @()
  for($k = 0; $k -lt 5; $k++){
    $o = "$(& nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>$null)".Trim(); $x = 0.0
    if([double]::TryParse((($o -split "`r?`n")[0]).Trim(), [ref]$x)){ $v += $x } else { $v += 100 }
    if($k -lt 4){ Start-Sleep -Seconds 1 }
  }
  ($v | Measure-Object -Average).Average
}
function BudgetGet {
  if(-not (Test-Path -LiteralPath $Budget)){ return [pscustomobject]@{ used_min = 0.0; jobs = 0 } }
  try { $b = [IO.File]::ReadAllText($Budget) | ConvertFrom-Json; [void][double]$b.used_min; return $b }
  catch { return [pscustomobject]@{ used_min = [double]$GpuCapMin; jobs = $JobMax } }   # unreadable budget = fail closed
}
function BudgetAdd($min){ $b = BudgetGet; WriteJson $Budget ([ordered]@{ used_min = [math]::Round([double]$b.used_min + $min, 1); jobs = [int]$b.jobs + 1; cap_min = $GpuCapMin; job_cap = $JobMax; updated = (Get-Date -f s) }) }
function JobResult($id, $h){
  $b = BudgetGet; $h['id'] = $id; $h['finished'] = (Get-Date -f s); $h['budget_used_min'] = $b.used_min; $h['budget_cap_min'] = $GpuCapMin
  WriteJson "$Jobs\$id.result.json" $h; Log "P7 job $id ok=$($h['ok']) $($h['note'])"
}
function RunProc($exe, [string[]]$argv, $id, $min){
  $line = ($argv | ForEach-Object { if($_ -match '[\s"]'){ '"' + ($_ -replace '"', '\"') + '"' } else { $_ } }) -join ' '
  Log "P7 job $id start: $exe $line (timeout $min min)"
  $p = Start-Process $exe -ArgumentList $line -WorkingDirectory "$C\scripts" -RedirectStandardOutput "$Jobs\$id.out" -RedirectStandardError "$Jobs\$id.err.out" -WindowStyle Hidden -PassThru; $null = $p.Handle
  if(-not $p.WaitForExit([int]($min * 60000))){ taskkill /T /F /PID $p.Id | Out-Null; Log "P7 job $id TIMEOUT after $min min (a ComfyUI prompt may still be queued; gpu_guard will wait for it)"; return -999 }
  $p.ExitCode
}
function ReuseRanking([string]$f){
  # p7lock 2026-10-20: a P6 ranking from overnight_chain.ps1 is reused when it is < 18 h old, model-judged with the CURRENT rubric of
  # p6_review.py, covers 5 videos, has <= 25% judge failures and its .md exists. Anything else (or any error) = $null = judge again.
  try{
    if(-not (Test-Path -LiteralPath $f)){ return $null }
    if((Get-Item -LiteralPath $f).LastWriteTime -lt (Get-Date).AddHours(-18)){ return $null }
    $md = $f -replace '\.json$', '.md'; if(-not (Test-Path -LiteralPath $md)){ return $null }
    $o = [IO.File]::ReadAllText($f) | ConvertFrom-Json
    $rv = [regex]::Match([IO.File]::ReadAllText($Rev), '(?m)^RUBRIC_VERSION\s*=\s*"([^"]+)"').Groups[1].Value
    $rk = @($o.ranking)
    if($o.model_used -ne $true -or -not $rv -or "$($o.rubric)" -ne $rv -or $rk.Count -ne 5){ return $null }
    if([double]$o.asks -le 0 -or ([double]$o.judge_failures / [double]$o.asks) -gt 0.25){ return $null }
    return "reused runs\P6_RANKING.json from $($o.when) (overnight_chain pre-run; rubric $rv, judge $($o.judge), $($o.judge_failures)/$($o.asks) judge failures); no GPU time used"
  } catch { return $null }
}
function RunJobs($n){
  $arch = "$Jobs\request_iter$n.json"; Move-Item -LiteralPath $Req -Destination $arch -Force
  $r = $null; try { $r = [IO.File]::ReadAllText($arch) | ConvertFrom-Json } catch { WriteJson "$Jobs\request_iter$n.result.json" @{ ok = $false; note = "unreadable JSON: $($_.Exception.Message)" }; Log "P7 request iter $n unreadable"; return }
  $cnt = if($null -eq $r.jobs){ 0 } else { @($r.jobs).Count }
  if($cnt -lt 1 -or $cnt -gt 3){ WriteJson "$Jobs\request_iter$n.result.json" @{ ok = $false; note = "refused: a request needs 1-3 jobs (got $cnt)" }; Log "P7 request iter $n refused: $cnt jobs"; return }
  foreach($j in @($r.jobs)){
    if($null -eq $j){ continue }
    $id = "$($j.id)"; $kind = "$($j.kind)"
    if($id -notmatch '^p7_[a-z0-9_]{3,48}$'){ Log "P7 job refused: bad id '$id'"; continue }
    if(Test-Path -LiteralPath "$Jobs\$id.result.json"){ Log "P7 job $id refused: id already used"; continue }
    $b = BudgetGet
    if([double]$b.used_min -ge $GpuCapMin){ JobResult $id @{ ok = $false; refused = 'budget'; note = "refused: budget (GPU cap $GpuCapMin min used up)" }; continue }
    if([int]$b.jobs -ge $JobMax){ JobResult $id @{ ok = $false; refused = 'budget'; note = "refused: budget (job cap $JobMax reached)" }; continue }
    if(-not (GuardWait)){ JobResult $id @{ ok = $false; refused = 'gpu-busy'; note = 'refused: GPU busy (gpu_guard / utilisation), job not run' }; $script:JobStop = $true; return }
    $t0 = Get-Date; $rc = $null; $ok = $false; $outs = @(); $note = ''
    if($kind -eq 'render'){
      $shots = "$C\shots\$id.json"; $run = "$C\runs\$id"
      if(-not (Test-Path -LiteralPath $shots)){ JobResult $id @{ ok = $false; note = "refused: missing $shots" }; continue }
      if(Test-Path -LiteralPath $run){ JobResult $id @{ ok = $false; note = "refused: run folder already exists $run (pick a new id)" }; continue }
      $chk = (& $py $Rev checkshots $shots $id 2>&1 | Out-String).Trim()
      if($LASTEXITCODE -ne 0){ JobResult $id @{ ok = $false; note = "refused: checkshots $chk" }; continue }
      $sl = [IO.File]::ReadAllText($shots) | ConvertFrom-Json; $nShots = @($sl).Count
      $reuse = @(); $bad = ''
      if($null -ne $j.reuse_prompts){ foreach($rp in @($j.reuse_prompts)){
        if($null -eq $rp){ continue }
        $sr = "$($rp.src_run)"; $si = "$($rp.src_id)"; $di = "$($rp.dst_id)"
        if($sr -notmatch '^p[67]_[a-z0-9_]+$' -or $si -notmatch '^[a-z0-9_]+$' -or $di -notmatch ('^' + [regex]::Escape($id) + '_seg[1-3]$')){ $bad = "bad reuse_prompts entry $sr/$si -> $di"; break }
        if(-not (Test-Path -LiteralPath "$C\runs\$sr\prompts")){ $bad = "no prompts folder runs\$sr\prompts"; break }
        $reuse += ,@($sr, $si, $di)
      } }
      if($bad){ JobResult $id @{ ok = $false; note = "refused: $bad" }; continue }
      $pd = "$run\prompts"; New-Item -ItemType Directory -Force $pd | Out-Null; $copied = 0
      foreach($e in $reuse){
        foreach($f in @(Get-ChildItem -LiteralPath "$C\runs\$($e[0])\prompts" -File)){
          if($f.Name -match ('^' + [regex]::Escape($e[1]) + '(_c\d+_[a-z0-9_]+\.txt(\.json)?)$')){ $dst = Join-Path $pd ($e[2] + $Matches[1]); if(-not (Test-Path -LiteralPath $dst)){ Copy-Item -LiteralPath $f.FullName -Destination $dst; $copied++ } }
        }
      }
      $stitch = -not ($j.stitch -eq $false)
      $argv = @('-u', $BQ, $shots, $id, '--no-upload'); if(-not $stitch){ $argv += '--no-stitch' }
      $rc = RunProc $CPy $argv $id (25 * $nShots + 15)
      try { Invoke-WebRequest "$LSU/unload" -UseBasicParsing -TimeoutSec 120 | Out-Null } catch {}   # ComfyUI has ttl 0: free the GPU for the next iteration
      $res = "$run\results.json"; $got = 0; if(Test-Path -LiteralPath $res){ $rj = [IO.File]::ReadAllText($res) | ConvertFrom-Json; $got = @($rj).Count }
      $st = "$run\${id}_stitched.mp4"
      $ok = ($rc -eq 0) -and ($got -eq $nShots) -and ((-not $stitch) -or (Test-Path -LiteralPath $st))
      $outs = @($res); if(Test-Path -LiteralPath $st){ $outs += $st }
      $note = "batch_queue rc=$rc rendered=$got/$nShots prompts_reused=$copied stitch=$stitch"
    } elseif($kind -eq 'review'){
      $judge = if(@('qwen3vl_judge', 'vl_judge') -contains "$($j.judge)"){ "$($j.judge)" } else { 'qwen3vl_judge' }
      $np = if($null -eq $j.pairs){ 0 } else { @($j.pairs).Count }; $nc = if($null -eq $j.cands){ 0 } else { @($j.cands).Count }
      $spec = '^p[67]_[a-z0-9_]+(:seg[1-9])?$'; $argv = $null
      if("$($j.preset)" -eq 'p6'){
        $out = "$C\runs\P6_RANKING"
        $reuse = ReuseRanking "$out.json"   # p7lock: overnight_chain.ps1 already ranked P6 right before the loop -> no second judge pass
        if($reuse){ JobResult $id @{ ok = $true; kind = $kind; rc = 0; wall_min = 0; started = $t0.ToString('s'); outputs = @("$out.md", "$out.json"); note = $reuse; log = '' }; continue }
        $argv = @('-u', $Rev, 'rank', '--preset', 'p6', '--judge', $judge, '--out', $out)
      }
      elseif($np -ge 1 -and $np -le 3){
        $out = "$Revs\$id\review"; $argv = @('-u', $Rev, 'compare', '--judge', $judge, '--out', $out)
        foreach($pp in @($j.pairs)){ $pa, $ch = "$pp" -split '=', 2; if($pa -notmatch $spec -or $ch -notmatch $spec){ $argv = $null; break }; $argv += @('--pair', "$pa=$ch") }
      } elseif($nc -ge 2 -and $nc -le 5){
        $out = "$Revs\$id\review"; $argv = @('-u', $Rev, 'rank', '--judge', $judge, '--out', $out)
        foreach($cc in @($j.cands)){ if("$cc" -notmatch $spec){ $argv = $null; break }; $argv += @('--cand', "$cc") }
      }
      if($null -eq $argv){ JobResult $id @{ ok = $false; note = 'refused: review job needs preset "p6", 1-3 pairs "PARENT=CHILD" or 2-5 cands (p6_/p7_ run names, optional :segN)' }; continue }
      New-Item -ItemType Directory -Force (Split-Path $out) | Out-Null
      $rc = RunProc $py $argv $id 120
      $ok = ($rc -eq 0) -and (Test-Path -LiteralPath "$out.json"); $outs = @("$out.md", "$out.json")
      $note = "p6_review rc=$rc (0 ok, 2 input error, 3 refused: GPU busy/lock/adults-only guard, 5 judge replies unusable)"
    } else { JobResult $id @{ ok = $false; note = "refused: unknown kind '$kind' (render | review)" }; continue }
    $min = ((Get-Date) - $t0).TotalMinutes; BudgetAdd $min
    JobResult $id @{ ok = $ok; kind = $kind; rc = $rc; wall_min = [math]::Round($min, 1); started = $t0.ToString('s'); outputs = $outs; note = $note; log = "$Jobs\$id.out" }
  }
}
$py = (Get-Command python -ErrorAction SilentlyContinue).Source; if(-not $py){ $py = 'C:\Program Files\Python312\python.exe' }
$cli="$env:APPDATA\npm\node_modules\@earendil-works\pi-coding-agent\dist\bundle\cli.js"
$a="`"$cli`" --print --provider llama-swap --model coding_sc117_strata --exclude-tools codemode,tool_search --no-mcp --session-dir `"$Sess`" `"@$K\PROMPT.md`" `"Follow PROMPT.md exactly.`""
$why='max-iterations'; $i=0; $cut=0; $np=0
while($i -lt $Max){
  if(Test-Path "$K\STOP_RALPH"){$why='STOP_RALPH';break}; if((Open) -eq 0){$why='COMPLETE';break}
  if(-not (GuardWait)){ $why='gpu-busy'; break }
  $i++; $n='{0:D2}' -f $i
  $preTasks = FHash "$K\TASKS.md"; $preTicks = Ticks; $preAgents = FHash $Agents
  Commit "pre iter $n"
  $snapDir = WfSnapshot $n; $wfBefore = WfHashes; $protBefore = ProtSnapshot $n
  "$(Get-Date -f s) iter $n start" | Add-Content "$L\ralph.log"; $t0 = Get-Date
  $p=Start-Process node -ArgumentList $a -WorkingDirectory $R -RedirectStandardOutput "$L\iter_$n.log" -RedirectStandardError "$L\iter_$n.err.log" -WindowStyle Hidden -PassThru; $null=$p.Handle
  $p.Id | Set-Content "$L\pi.pid"
  $timedOut = $false
  if(-not $p.WaitForExit($TimeoutMin*60000)){ taskkill /T /F /PID $p.Id | Out-Null; $timedOut = $true; "TIMEOUT after $TimeoutMin min" | Add-Content "$L\ralph.log" }
  $code = $p.ExitCode
  "$(Get-Date -f s) iter $n exit $code" | Add-Content "$L\ralph.log"
  if(-not $timedOut -and $code -eq 1){ $cut++; Log "iter $n CUTOFF (pi exit 1: reply cut off at the output limit) [$cut in a row]" } else { $cut = 0 }
  # --- harness checks on changed files (the harness runs them, not the model)
  $fails = @(); $viol = @()
  $chg = @(Changed $C | ForEach-Object { [pscustomobject]@{ Code=$_.Code; Path=$_.Path; Full=(Join-Path $C $_.Path) } }) + @(Changed $K | ForEach-Object { [pscustomobject]@{ Code=$_.Code; Path=$_.Path; Full=(Join-Path $K $_.Path); InK=$true } })
  foreach($ch in $chg){
    if(-not (Test-Path -LiteralPath $ch.Full -PathType Leaf)){ continue }
    if($ch.Full -match '\.py$'){ $o = @(& $py -m py_compile $ch.Full 2>&1 | ForEach-Object { "$_".Trim() } | Where-Object { $_ }); if($LASTEXITCODE -ne 0){ $fails += "py_compile $($ch.Full): $(($o | Select-Object -Last 2) -join ' / ')" } }
    elseif($ch.Full -match '\.json$'){ $o = @(& $py -m json.tool $ch.Full 2>&1 | ForEach-Object { "$_".Trim() } | Where-Object { $_ }); if($LASTEXITCODE -ne 0){ $fails += "json.tool $($ch.Full): $($o | Select-Object -Last 1)" } }
  }
  # --- scope check: ralph-community may change TASKS.md, STOP_RALPH, notes\* only; C:\AI\community is the work dir
  foreach($ch in @($chg | Where-Object { $_.InK })){
    $rel = $ch.Path -replace '/','\'
    if($rel -eq 'TASKS.md' -or $rel -eq 'STOP_RALPH' -or $rel -like 'notes\*'){ continue }
    if($ch.Code -eq '??'){ $viol += "new file outside scope (left in place, review it): $($ch.Full)" }
