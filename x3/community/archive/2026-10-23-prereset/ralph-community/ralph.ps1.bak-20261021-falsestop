  }
  foreach($ch in @($chg | Where-Object { -not $_.InK -and ($_.Path -match '(?i)comfyui[\\/]user[\\/]') })){ $null = G -C $C checkout '--' $ch.Path; $viol += "ComfyUI\user path restored: $($ch.Full)" }
  $wfAfter = WfHashes
  foreach($f in $wfBefore.Keys){
    if($wfAfter[$f] -ne $wfBefore[$f]){ $src = Join-Path $snapDir $f.Substring($WF.Length).TrimStart('\'); Copy-Item -LiteralPath $src -Destination $f -Force; $viol += "live ComfyUI file changed/deleted, restored from $src : $f" }
  }
  foreach($f in $wfAfter.Keys){ if(-not $wfBefore.ContainsKey($f)){ $viol += "new file under ComfyUI\user (left in place, review it): $f" } }
  $viol += @(ProtCheck $protBefore)
  if((FHash $Agents) -ne $preAgents){ Log "iter $n note: 5slock\AGENTS.md was updated by the model (allowed: command notes)" }
  foreach($f in $fails){ Log "iter $n CHECK FAIL: $f" }; foreach($v in $viol){ Log "iter $n SCOPE: $v" }
  $status = if($fails.Count -or $viol.Count -or $timedOut -or ($code -ne 0)){ 'fail' } else { 'ok' }
  Commit "iter ${n}: $status"
  # --- one-line summary
  $den = 0; $sf = Get-ChildItem -LiteralPath $Sess -Recurse -File -Filter *.jsonl -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -ge $t0 } | Sort-Object LastWriteTime -Descending | Select-Object -First 1
  if($sf){ $den = @(Select-String -LiteralPath $sf.FullName -Pattern 'is not permitted to run|requires approval|Blocked by (headless guard|protected-paths)' -AllMatches | ForEach-Object { $_.Matches.Count } | Measure-Object -Sum).Sum; if(-not $den){ $den = 0 } }
  $ex = if($timedOut){ 'TIMEOUT' } elseif($code -eq 1){ '1(CUTOFF)' } else { "$code" }
  Log ("iter $n summary: status=$status exit=$ex ticks=+{0} wall={1:N1}m denies={2} checkfails={3} scope={4} open={5}" -f ((Ticks) - $preTicks), ((Get-Date)-$t0).TotalMinutes, $den, $fails.Count, $viol.Count, (Open))
  # --- stop rules (existing STOP_RALPH / COMPLETE logic kept)
  if($viol.Count){ Stop-Ralph "iter ${n}: scope check failed - $($viol -join ' | ')"; $why='scope'; break }
  if($fails.Count){ Stop-Ralph "iter ${n}: harness check failed - $($fails -join ' | ')"; $why='check-failed'; break }
  # --- P7: run the GPU job the model requested, only after a clean iteration and before the next one starts (pi has exited)
  if(Test-Path -LiteralPath $Req){
    if($status -eq 'ok'){ RunJobs $n; if($script:JobStop){ $why='gpu-busy'; break } }
    else { Move-Item -LiteralPath $Req -Destination "$Jobs\request_iter$n.skipped.json" -Force; Log "iter ${n}: JOB_REQUEST skipped (iteration status=$status)" }
  }
  if(Select-String -Path "$L\iter_$n.log" -Pattern '^\s*COMPLETE\s*$' -Quiet){$why='COMPLETE';break}
  if($cut -ge 2){ Stop-Ralph "pi was cut off at the output limit 2 iterations in a row (iter $n)"; $why='cutoff'; break }
  if((FHash "$K\TASKS.md") -eq $preTasks){ $np++ } else { $np = 0 }
  if($np -ge 2){ Stop-Ralph "no progress: TASKS.md unchanged for 2 iterations (iter $n)"; $why='no-progress'; break }
}
$t=@(Select-String -Path "$K\TASKS.md" -Pattern '^\s*- \[x\]').Count; $b=@(Select-String -Path "$K\TASKS.md" -Pattern '^\s*- \[!\]').Count
"community ralph done $(Get-Date -f s) reason=$why iterations=$i ticked=$t blocked=$b open=$(Open)" | Set-Content "$L\DONE.txt"
