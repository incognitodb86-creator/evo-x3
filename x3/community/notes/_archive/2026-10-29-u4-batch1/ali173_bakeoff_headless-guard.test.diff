+// bakeoff 2026-10-23 (ALI-173, Derrick 1:07 PM CT "Yes, add 120 GPU min and 10 jobs for the bakeoff and let Forge restart and call ComfyUI itself")
+test("bakeoff ComfyUI API: read + queue on :8188/:8189/:10004 (allowed) vs interrupt/free/other GPU ports (blocked)", () => {
+	// allowed
+	assert.equal(ps("curl.exe -s http://127.0.0.1:10004/queue"), null);
+	assert.equal(ps("curl.exe -s http://127.0.0.1:8188/system_stats; curl.exe -s http://127.0.0.1:8189/history"), null);
+	assert.equal(ps("curl.exe -s -X POST -H \"Content-Type: application/json\" --data-binary \"@C:\\AI\\community\\notes\\bake\\b4.json\" http://127.0.0.1:10004/prompt"), null);
+	assert.equal(ps("python -c \"import urllib.request as u; print(u.urlopen('http://127.0.0.1:10004/history').read()[:200])\""), null);
+	assert.equal(ps("curl.exe -s \"http://127.0.0.1:10004/view?filename=a.png&type=output\" -o C:\\AI\\community\\notes\\bake\\a.png"), null);
+	// blocked
+	assert.equal(ps("curl.exe -s -X POST http://127.0.0.1:10004/interrupt")?.id, "gpu-endpoints");
+	assert.equal(ps("curl.exe -s -X POST http://127.0.0.1:10004/free")?.id, "gpu-endpoints");
+	assert.equal(ps("curl.exe -s http://127.0.0.1:10002/v1/models")?.id, "gpu-endpoints", "Strata's own port stays blocked");
+	assert.equal(ps("curl.exe -s -X POST -d x https://github.com/x")?.id, "curl-method");
+	assert.equal(ext.checkCommand("curl -s http://127.0.0.1:10004/prompt")?.id, "gpu-endpoints", "non-Forge sessions unchanged");
+});
+
+test("bakeoff llama-swap: /v1 + /comfyui/ wake (allowed) vs /upstream, /unload, /api, /running (blocked)", () => {
+	assert.equal(ps("curl.exe -s -X POST -H \"Content-Type: application/json\" -d \"@C:\\AI\\community\\notes\\bake\\chat.json\" http://127.0.0.1:8080/v1/chat/completions"), null);
+	assert.equal(ps("curl.exe -s http://127.0.0.1:8080/v1/models"), null);
+	assert.equal(ps("curl.exe -s http://127.0.0.1:8080/comfyui/"), null);
+	assert.equal(ps("curl.exe -s http://127.0.0.1:8080/upstream/coding_swift15_iq3s/v1/models")?.id, "gpu-endpoints");
+	assert.equal(ps("curl.exe -s -X POST http://127.0.0.1:8080/api/models/unload/comfyui_auto")?.id, "gpu-endpoints");
+	assert.equal(ps("curl.exe -s http://127.0.0.1:8080/unload")?.id, "gpu-endpoints");
+	assert.equal(ps("curl.exe -s http://127.0.0.1:8080/running")?.id, "gpu-endpoints");
+	assert.equal(ps("curl.exe -s -X POST -H \"Authorization: Bearer x\" http://127.0.0.1:8080/v1/chat/completions")?.id, "curl-arg");
+});
