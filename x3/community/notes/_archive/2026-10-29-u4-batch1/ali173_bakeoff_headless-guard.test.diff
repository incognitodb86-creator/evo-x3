+test("bakeoff restart: comfy_ctl.py restart while idle (allowed) vs during a running render (blocked); raw kills stay blocked", () => {
+	const prev = process.env.PI_GUARD_RENDER_RUNNING;
+	try {
+		process.env.PI_GUARD_RENDER_RUNNING = "0";
+		assert.equal(ps("python C:\\AI\\community\\scripts\\comfy_ctl.py restart"), null);
+		assert.equal(ps("& C:\\AI\\director\\.venv\\Scripts\\python.exe C:/AI/community/scripts/comfy_ctl.py stop"), null);
+		assert.equal(ps("python C:\\AI\\community\\scripts\\comfy_ctl.py status"), null);
+		process.env.PI_GUARD_RENDER_RUNNING = "1";
+		assert.equal(ps("python C:\\AI\\community\\scripts\\comfy_ctl.py restart")?.id, "comfy-restart-busy");
+		assert.equal(ps("python C:\\AI\\community\\scripts\\comfy_ctl.py stop")?.id, "comfy-restart-busy");
+		assert.equal(ps("python C:\\AI\\community\\scripts\\comfy_ctl.py status"), null, "status is always allowed");
+		assert.equal(ps("Stop-Process -Name python")?.id, "hazard-command");
+		assert.equal(ps("taskkill /F /IM python.exe")?.id, "hazard-command");
+	} finally {
+		if (prev === undefined) delete process.env.PI_GUARD_RENDER_RUNNING; else process.env.PI_GUARD_RENDER_RUNNING = prev;
+	}
+});
