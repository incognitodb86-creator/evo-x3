+// bakeoff 2026-10-23 (ALI-173, Derrick 1:07 PM CT "Yes, add 120 GPU min and 10 jobs for the bakeoff and let Forge restart and call ComfyUI itself"):
+// Forge sessions may call ComfyUI's HTTP API (read + queue) on :8188 / :8189 / :10004 (ComfyUI's own port under llama-swap) and llama-swap's
+// OpenAI-style /v1 endpoints + the documented /comfyui/ wake route on :8080. Still blocked: /upstream/*, /unload + /load, /interrupt, /free,
+// llama-swap's /api/* and every other local GPU port (e.g. Strata :10002). Restarts go through scripts\comfy_ctl.py, refused while a render runs.
+const LOCAL_URL = /(?:https?:\/\/)?(?:127\.0\.0\.1|localhost|0\.0\.0\.0|\[::1\]):(\d{2,5})(\/[^\s"'`)\]},;|&]*)?/gi;
+const COMFY_PORTS = new Set(["8188", "8189", "10004"]);
+const COMFY_PATH_OK = /^\/(?:api\/)?(?:prompt|queue|history(?:\/[\w-]+)?|view|upload\/image|system_stats|object_info\/[\w.%-]+|embeddings|extensions|features|models(?:\/[\w-]+)?)?\/?(?:\?[^\s]*)?$/i;
+const LS_PATH_OK = /^\/(?:v1\/(?:chat\/completions|completions|models|embeddings)|comfyui)\/?(?:\?[^\s]*)?$/i;
+export function isAllowedLocalUrl(port: string, path: string | undefined): boolean {
+	const pth = path && path.length ? path : "/";
+	if (COMFY_PORTS.has(port)) return COMFY_PATH_OK.test(pth);
+	if (port === "8080") return LS_PATH_OK.test(pth);
+	return false;
+}
+/** Masks the allowed local ComfyUI / llama-swap /v1 URLs so the normal deny rules judge the rest of the command. */
+export function maskAllowedLocal(command: string): string {
+	return command.replace(LOCAL_URL, (m, port: string, path: string | undefined) => (isAllowedLocalUrl(port, path) ? "LOCAL_API_OK" : m));
+}
