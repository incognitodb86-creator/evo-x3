test("truncation: shape is first 40 + last 40 + path, and stays small", () => {
	const text = Array.from({ length: 5000 }, (_, i) => `line-${i + 1} ${"y".repeat(60)}`).join("\n");
	const out = ext.formatTruncated(text, "C:\\tmp\\full.txt");
	assert.ok(out.includes("C:\\tmp\\full.txt"));
	assert.ok(out.includes("line-1 ") && out.includes("line-40 "));
	assert.ok(!out.includes("line-41 ") && !out.includes("line-4960 "));
	assert.ok(out.includes("line-4961 ") && out.includes("line-5000 "));
	assert.ok(out.includes("4920 lines omitted"));
	assert.ok(Buffer.byteLength(out) < 32 * 1024);
});

test("truncation: one gigantic line is clipped (no 32 KB escape hatch)", () => {
	const text = `{"blob":"${"z".repeat(2_000_000)}"}`;
	const out = ext.formatTruncated(text, "C:\\tmp\\full.txt");
	assert.ok(Buffer.byteLength(out) < 4096);
	assert.ok(out.includes("chars]"));
});

