test("handler blocks with a readable reason", async () => {
	const handlers = {};
	ext.default({ on: (n, fn) => ((handlers[n] ??= []).push(fn), () => {}) });
	const ctx = { hasUI: false, cwd: CWD };
	const r = await handlers.tool_call[0]({ toolName: "write", input: { path: "C:\\AI\\director\\config\\llama-swap.yaml", content: "" } }, ctx);
	assert.equal(r.block, true);
	assert.match(r.reason, /^Blocked by protected-paths \[llama-swap-config\]/);
	assert.equal(await handlers.tool_call[0]({ toolName: "write", input: { path: "C:\\AI\\community\\x.md", content: "" } }, ctx), undefined);
});
