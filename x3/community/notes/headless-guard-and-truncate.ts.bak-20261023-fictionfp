// Command allowlist (ALI-160 K4, Derrick 2026-10-23 7:01 AM CT: "Keep PowerShell, allowlist in our guard")
// ---------------------------------------------------------------------------------------------------------------
// Headless runs only (unless applyInUI): every bash/powershell command segment must start with an allowlisted command.
// The list lives in headless-guard-allowlist.json next to this file. The denylist above runs first and wins.
// Best-effort static parse (quotes, heredocs, here-strings, $( ), { }, ( ), backticks), not a sandbox. Unparseable = blocked.

export const ALLOWLIST_FILE = "headless-guard-allowlist.json";

export interface Allowlist {
	applyInUI?: boolean;
	tools: string[];
	commands: Record<string, string[]>;
	aliases?: Record<string, string>;
	denyReasons?: Record<string, string>;
	git?: { subcommands?: string[]; denySubcommands?: string[] };
	python?: { modules?: string[]; scriptRoots?: string[] };
	copyItem?: { sourceRoots?: string[]; destRoots?: string[]; protectRoots?: string[]; imageExts?: string[] };   // ALI-163 (2026-10-23; copywide 11:09 AM CT)
	// community 2026-10-23 (Derrick 11:49 AM CT "Yes, switch Forge to the community permissions (1, 2, 4, 5)"):
	// mode "denylist" = any command runs unless it is a named hazard; only the commands in denylist.argChecked get argument rules.
	mode?: "allowlist" | "denylist";
	/** forgeopen 2026-10-23: true (default) = headless Forge sessions are blocked on secrets only. false = previous denylist mode. */
	forgeOpen?: boolean;
	/** denylist mode applies only to sessions whose cwd is under one of these (Forge); other headless sessions keep the allowlist. */
	denylistCwdRoots?: string[];
	denylist?: { commands?: Record<string, string>; argChecked?: string[] };
	web?: { domains?: string[]; outputRoots?: string[] };
}

// Where to look for the JSON. Pi's extension loader does not always expose import.meta.url/dirname, so fall back to
// __dirname and finally the install path that ~/.pi/agent/settings.json points at.
export const ALLOWLIST_DEFAULT_DIR = "C:/AI/director/.pi/extensions";

function allowlistCandidates(): string[] {
	const dirs: string[] = [];
	try {
		const meta = import.meta as { dirname?: string; url?: string };
		if (meta.dirname) dirs.push(meta.dirname);
		if (meta.url && meta.url.startsWith("file:")) dirs.push(dirname(fileURLToPath(meta.url)));
	} catch {
		// not available under this loader
	}
	try {
		// __dirname exists when the loader transpiles to CommonJS
		if (typeof __dirname === "string") dirs.push(__dirname);
	} catch {
		// ESM without __dirname
	}
	dirs.push(ALLOWLIST_DEFAULT_DIR);
	const files = dirs.map((d) => join(d, ALLOWLIST_FILE));
	if (process.env.PI_GUARD_ALLOWLIST) files.unshift(process.env.PI_GUARD_ALLOWLIST);
	return files;
}

let cachedAllowlist: Allowlist | null = null;

/** Loads (and caches) the allowlist JSON. Throws when missing/invalid: the caller fails closed. */
export function loadAllowlist(path?: string): Allowlist {
	if (cachedAllowlist) return cachedAllowlist;
	if (!path) path = allowlistCandidates().find((f) => existsSync(f)) ?? join(ALLOWLIST_DEFAULT_DIR, ALLOWLIST_FILE);
	const raw = JSON.parse(readFileSync(path, "utf8")) as Allowlist;
	if (!raw || !Array.isArray(raw.tools) || typeof raw.commands !== "object") throw new Error(`invalid allowlist ${path}`);
	cachedAllowlist = raw;
	return raw;
}

interface Parsed {
	segments: string[];
	nested: { text: string; tool: string; hashtable?: boolean }[];
	error?: string;
}

/** Finds the end index (exclusive) of a balanced group that starts right after `open` at index i. Quote-aware. */
function balancedEnd(s: string, i: number, open: string, close: string, tool: string): number {
	let depth = 1;
	while (i < s.length) {
		const ch = s[i];
		if (ch === "'") {
			const j = s.indexOf("'", i + 1);
			if (j < 0) return -1;
			i = j + 1;
			continue;
		}
		if (ch === '"') {
			i++;
			while (i < s.length && s[i] !== '"') i += (tool === "bash" && s[i] === "\\") || (tool !== "bash" && s[i] === "`") ? 2 : 1;
			if (i >= s.length) return -1;
			i++;
			continue;
		}
		if ((tool === "bash" && ch === "\\") || (tool !== "bash" && ch === "`")) {
			i += 2;
			continue;
		}
		if (ch === open) depth++;
		else if (ch === close && --depth === 0) return i + 1;
		i++;
	}
	return -1;
}

/** Splits a command into top-level segments (on ; | && || & newline) and collects nested command bodies. */
export function splitCommand(cmd: string, tool: string): Parsed {
	const ps = tool !== "bash";
	const out: Parsed = { segments: [], nested: [] };
	let cur = "";
	const heredocs: { delim: string; strip: boolean; quoted: boolean }[] = [];
	const flush = () => {
		if (cur.trim()) out.segments.push(cur.trim());
		cur = "";
	};
	let i = 0;
	const n = cmd.length;
	while (i < n) {
		const ch = cmd[i];
		const next = cmd[i + 1] ?? "";
		// newline: end segment; consume pending bash heredoc bodies
		if (ch === "\n" || ch === "\r") {
			flush();
			i++;
			if (ch === "\r" && cmd[i] === "\n") i++;
			while (heredocs.length) {
				const h = heredocs.shift() as { delim: string; strip: boolean; quoted: boolean };
				let found = false;
				const body: string[] = [];
				while (i < n) {
					let e = cmd.indexOf("\n", i);
					if (e < 0) e = n;
					const line = cmd.slice(i, e).replace(/\r$/, "");
					i = e + 1;
					if ((h.strip ? line.replace(/^\t+/, "") : line) === h.delim) {
						found = true;
						break;
					}
					body.push(line);
				}
				if (!found) return { ...out, error: `heredoc <<${h.delim} is not closed` };
				if (!h.quoted && /\$\(|`/.test(body.join("\n"))) return { ...out, error: "unquoted heredoc with $( ) or backticks; quote the delimiter (<<'EOF')" };
			}
			continue;
		}
		// comments
		if (ch === "#" && (cur === "" || /\s$/.test(cur))) {
			while (i < n && cmd[i] !== "\n") i++;
			continue;
		}
		// quotes
		if (ch === "'") {
			let j = i + 1;
			for (;;) {
				j = cmd.indexOf("'", j);
				if (j < 0) return { ...out, error: "unclosed single quote" };
				if (ps && cmd[j + 1] === "'") {
					j += 2;
					continue;
				}
				break;
			}
			cur += cmd.slice(i, j + 1);
			i = j + 1;
			continue;
		}
		if (ch === '"') {
			let j = i + 1;
			let text = '"';
			while (j < n && cmd[j] !== '"') {
				const c = cmd[j];
				if ((!ps && c === "\\") || (ps && c === "`")) {
					text += cmd.slice(j, j + 2);
					j += 2;
					continue;
				}
				if (c === "$" && cmd[j + 1] === "(") {
					const end = balancedEnd(cmd, j + 2, "(", ")", tool);
					if (end < 0) return { ...out, error: "unbalanced $( in string" };
					out.nested.push({ text: cmd.slice(j + 2, end - 1), tool });
					text += "$()";
					j = end;
					continue;
				}
				if (!ps && c === "`") {
					const end = cmd.indexOf("`", j + 1);
					if (end < 0) return { ...out, error: "unclosed backtick" };
					out.nested.push({ text: cmd.slice(j + 1, end), tool });
					j = end + 1;
					continue;
				}
				text += c;
				j++;
			}
			if (j >= n) return { ...out, error: "unclosed double quote" };
			cur += `${text}"`;
			i = j + 1;
			continue;
		}
		// PowerShell here-strings @' ... '@ and @" ... "@
		if (ps && ch === "@" && (next === "'" || next === '"') && /^[ \t]*\r?\n/.test(cmd.slice(i + 2))) {
			const close = `\n${next}@`;
			const end = cmd.indexOf(close, i + 2);
			if (end < 0) return { ...out, error: "unclosed here-string" };
			const body = cmd.slice(i + 2, end);
			if (next === '"' && /\$\(/.test(body)) return { ...out, error: 'here-string @" "@ with $( ); use @\' \'@' };
			cur += "@''@";
			i = end + close.length;
			continue;
		}
		// escapes / line continuation
		if ((!ps && ch === "\\") || (ps && ch === "`")) {
			if (next === "\n" || next === "\r") {
				i += next === "\r" && cmd[i + 2] === "\n" ? 3 : 2;
				cur += " ";
				continue;
			}
			cur += cmd.slice(i, i + 2);
			i += 2;
			continue;
		}
		// bash heredoc / here-string
		if (!ps && ch === "<" && next === "<") {
			if (cmd[i + 2] === "<") {
				cur += "<<<";
				i += 3;
				continue;
			}
			const m = /^<<(-?)[ \t]*(?:'([^'\n]+)'|"([^"\n]+)"|\\?([A-Za-z_][\w-]*))/.exec(cmd.slice(i));
			if (!m) return { ...out, error: "unsupported << redirection" };
			heredocs.push({ delim: m[2] ?? m[3] ?? m[4], strip: m[1] === "-", quoted: m[4] === undefined || m[0].includes("\\") });
			cur += " <<HEREDOC ";
			i += m[0].length;
			continue;
		}
		// $( ... ), $(( ... )), ${ ... }
		if (ch === "$" && next === "(") {
			if (!ps && cmd[i + 2] === "(") {
				const end = balancedEnd(cmd, i + 2, "(", ")", tool);
				if (end < 0) return { ...out, error: "unbalanced $((" };
				cur += "0";
				i = end;
				continue;
			}
			const end = balancedEnd(cmd, i + 2, "(", ")", tool);
			if (end < 0) return { ...out, error: "unbalanced $(" };
			out.nested.push({ text: cmd.slice(i + 2, end - 1), tool });
			cur += "$()";
			i = end;
			continue;
		}
		if (ch === "$" && next === "{") {
			const end = cmd.indexOf("}", i + 2);
			if (end < 0) return { ...out, error: "unclosed ${" };
			cur += cmd.slice(i, end + 1);
			i = end + 1;
			continue;
		}
		if (!ps && ch === "`") {
			const end = cmd.indexOf("`", i + 1);
			if (end < 0) return { ...out, error: "unclosed backtick" };
			out.nested.push({ text: cmd.slice(i + 1, end), tool });
			cur += "$()";
			i = end + 1;
			continue;
		}
		// PowerShell { } script blocks / @{ } hashtables / ( ) and @( ) groups; bash ( ) subshell at segment start
		if (ps && ch === "{") {
			const end = balancedEnd(cmd, i + 1, "{", "}", tool);
			if (end < 0) return { ...out, error: "unbalanced {" };
			const hashtable = cur.endsWith("@");
			out.nested.push({ text: cmd.slice(i + 1, end - 1), tool, hashtable });
			cur += "{}";
			i = end;
			continue;
		}
		if (ch === "(" && (ps || cur.trim() === "")) {
			const end = balancedEnd(cmd, i + 1, "(", ")", tool);
			if (end < 0) return { ...out, error: "unbalanced (" };
			out.nested.push({ text: cmd.slice(i + 1, end - 1), tool });
			cur += "()";
			i = end;
			continue;
		}
		// separators
		if (ch === ";" || (ch === "|" && next === "|") || (ch === "&" && next === "&")) {
			flush();
			i += ch === ";" ? 1 : 2;
			continue;
		}
		if (ch === "|") {
			flush();
			i += 1;
			continue;
		}
		if (ch === "&") {
			const prev = cur.slice(-1);
			if (prev === ">" || next === ">") {
				cur += ch;
				i++;
				continue; // redirection 2>&1, &>
			}
			if (ps) {
				cur += ch;
				i++;
				continue; // call operator
			}
			flush();
			i++;
			continue; // bash background
		}
		cur += ch;
		i++;
	}
	if (heredocs.length) return { ...out, error: "heredoc body missing" };
	flush();
	return out;
}

/** Splits a segment into words (quotes kept on each word). */
function words(seg: string): string[] {
	const out: string[] = [];
	const re = /(?:'(?:[^']|'')*'|"(?:[^"\\`]|[\\`].)*"|[^\s'"]+)+/g;
	for (const m of seg.matchAll(re)) out.push(m[0]);
	return out;
}

function unquote(w: string): string {
	return w.replace(/^'(.*)'$/s, "$1").replace(/^"(.*)"$/s, "$1");
}

function normPath(p: string, cwd: string): string {
	let x = unquote(p).replace(/\\/g, "/");
	const gb = /^\/([a-zA-Z])(\/.*)?$/.exec(x);
	if (gb) x = `${gb[1]}:${gb[2] ?? "/"}`;
	const abs = win32.resolve(cwd.replace(/\//g, "\\"), x.replace(/\//g, "\\"));
	return abs.replace(/\\/g, "/").toLowerCase();
}

function underRoot(p: string, roots: string[], cwd: string): boolean {
	const abs = normPath(p, cwd);
	return roots.some((r) => {
		const root = normPath(r, cwd).replace(/\/+$/, "");
		return abs === root || abs.startsWith(`${root}/`);
	});
}

const BASH_PREFIX = new Set(["then", "do", "else", "elif", "if", "while", "until", "!", "{", "time"]);
const BASH_END = new Set(["fi", "done", "}", "esac", "then", "do", "else"]);
const PS_KEYWORDS = new Set([
	"if", "elseif", "else", "foreach", "for", "while", "do", "until", "switch", "try", "catch", "finally", "break", "continue",
	"param", "begin", "process", "end", "function", "filter",
]);
const PS_RETURN = new Set(["return", "throw", "exit"]);
const PY_FLAG_WITH_ARG = new Set(["-x", "-w"]);

function allowBlock(id: string, reason: string): Violation {
	return { id, reason };
}

function notAllowed(name: string, tool: string, al: Allowlist): Violation {
	const why = al.denyReasons?.[name];
	return allowBlock(
		"not-allowlisted",
		`\`${name}\` is not on the Forge ${tool} command allowlist${why ? ` (${why})` : ""}. ` +
			`Allowed: ${(al.commands[tool] ?? []).join(", ")}. The list is C:\\AI\\director\\.pi\\extensions\\${ALLOWLIST_FILE} (supervisor-only).`,
	);
}

/** Per-command argument rules. Returns a violation or null. */
function checkArgs(name: string, args: string[], tool: string, al: Allowlist, state: { cwd: string }, depth: number): Violation | null {
	const raw = args.map(unquote);
	if (name === "python" || name === "python3" || name === "py") {
		let k = 0;
		while (k < raw.length && /^-/.test(raw[k]) && raw[k] !== "-" && raw[k] !== "-c" && raw[k] !== "-m") {
			if (PY_FLAG_WITH_ARG.has(raw[k].toLowerCase())) k++;
			k++;
		}
		const a = raw[k];
		if (a === undefined || a === "-" || a === "-c" || a === "<<HEREDOC" || /^--?(?:version|V)$/.test(a)) return null;
		if (a === "-m") {
			const mod = raw[k + 1] ?? "";
			if ((al.python?.modules ?? []).includes(mod)) return null;
			return allowBlock("python-module", `python -m ${mod} is not allowed. Allowed modules: ${(al.python?.modules ?? []).join(", ")}.`);
		}
		const roots = al.python?.scriptRoots ?? [];
		if (/^[<>]/.test(a)) return null;
		if (underRoot(a, roots, state.cwd)) return null;
		return allowBlock("python-script-path", `python scripts must live under ${roots.join(", ")} (got ${a}).`);
	}
	if (name === "git") {
		let k = 0;
		while (k < raw.length && raw[k].startsWith("-")) {
			const f = raw[k];
			if (f === "-c" || /^--(?:exec-path|upload-pack|config-env)/.test(f)) return allowBlock("git-option", `git ${f} is not allowed (it can run programs).`);
			if (f === "-C" || f === "--git-dir" || f === "--work-tree" || f === "--namespace") k++;
			k++;
		}
		const sub = (raw[k] ?? "").toLowerCase();
		if (al.mode === "denylist") {
			// community 2026-10-23: Forge commits its own work with a real message; push/reset/checkout/clean & history rewrites stay blocked.
			const deny = al.git?.denySubcommands ?? ["push", "reset", "checkout", "clean", "restore", "rebase", "filter-branch", "update-ref", "gc", "prune"];
			if (deny.includes(sub)) return allowBlock("git-subcommand", `git ${sub} is not allowed (blocked: ${deny.join(", ")}). Commit locally; the supervisor pushes.`);
			if (sub === "diff" && raw.some((x) => /^--ext-diff$/.test(x))) return allowBlock("git-option", "git diff --ext-diff is not allowed.");
			if (sub === "add" || sub === "commit" || sub === "stash" || sub === "merge" || sub === "cherry-pick" || sub === "revert" || sub === "am" || sub === "tag" || sub === "branch" || sub === "switch") {
				// The loop repo (ralph-community) is the harness's: its pre-iter commits are what the scope check diffs against.
				const ci = raw.indexOf("-C");
				const repo = ci >= 0 && ci < k ? normPath(raw[ci + 1] ?? "", state.cwd) : normPath(".", state.cwd);
				if (/5slock\/ralph-community(?:\/|$)/i.test(repo) || (ci < 0 && /ralph-community/i.test(state.cwd)))
					return allowBlock("git-loop-repo", "git add/commit in ralph-community is the harness's job (its pre-iter commits back the scope check). Commit your work in C:/AI/community.");
				if (sub !== "add" && sub !== "commit") return allowBlock("git-subcommand", `git ${sub} is not allowed; only status/diff/log/show/add/commit.`);
			}
			if (sub === "add" && raw.slice(k + 1).some((x) => /(?:^|[\\/])\.env/i.test(x))) return allowBlock("env-file-edit", "never git add .env* files.");
			if (sub === "clone" || sub === "ls-remote" || sub === "submodule" || sub === "remote") {
				// community 2026-10-23: clones are read-only web; same domains as curl, into tools/ or ComfyUI custom_nodes only.
				if (sub === "submodule" || sub === "remote") { if (raw.slice(k + 1).some((x) => /^(?:add|set-url)$/i.test(x))) return allowBlock("git-remote", "git remote add/set-url and submodule add are not allowed."); return null; }
				const doms = (al.web?.domains ?? []).map((d) => d.toLowerCase());
