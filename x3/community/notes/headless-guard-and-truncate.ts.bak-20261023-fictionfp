export function checkPackageInstall(command: string): Violation | null {
	if (!PKG_INSTALL.test(command)) return null;
	const ok = PKG_TRIAL_OK.some((r) => r.test(command.trim())) || command.split(/;|\r?\n|&&|\|\|/).every((st) => !PKG_INSTALL.test(st) || PKG_TRIAL_OK.some((r) => r.test(st)));
	return ok ? null : { id: "package-install", reason: PKG_REASON };
}

const ENV_REASON = "editing .env* files (secrets/config) is not allowed in unattended runs. Ask the supervisor to change it, or read the value from the environment.";

const CODE_EXTENSIONS = new Set([".py", ".ps1", ".psm1", ".sh", ".bash", ".cmd", ".bat", ".js", ".mjs", ".cjs", ".ts"]);
const OBJECT_INFO_EXEMPT_FILES = new Set(["comfy_inspect.py", "comfy_probe.py"]);

const RAW_OBJECT_INFO = SHELL_RULES.find((r) => r.id === "raw-object-info") as Rule;

function isEnvPath(p: string): boolean {
	const base = basename(p.replace(/\\/g, "/")).toLowerCase();
	return base.startsWith(".env");
}

/** Returns a violation when a shell command matches the static denylist, otherwise null. */
export function checkCommand(command: string): Violation | null {
	for (const rule of SHELL_RULES) {
		if (rule.re.test(command)) return { id: rule.id, reason: rule.reason };
	}
	for (const stmt of command.split(/;|\r?\n|&&|\|\|/)) {
		if (ENV_REDIRECT.test(stmt) || (ENV_TOKEN.test(stmt) && WRITE_VERB.test(stmt))) {
			return { id: "env-file-edit", reason: ENV_REASON };
		}
		// community 2026-10-23: nothing in approved_characters is ever written, moved or removed (Copy-Item FROM it is checked in checkArgs).
		if (APPROVED_DIR.test(stmt) && (WRITE_NONCOPY.test(stmt) || />>?\s*["']?[^\s"']*approved_characters/i.test(stmt))) {
			return { id: "approved-write", reason: "5slock/approved_characters is read-only: never write, move, rename or remove anything there." };
		}
	}
	return null;
}

/** write/edit: blocks `.env*` targets, and executable-looking files that would fetch raw /object_info. */
export function checkFileWrite(path: string, newContent: string): Violation | null {
	if (isEnvPath(path)) return { id: "env-file-edit", reason: ENV_REASON };
	const base = basename(path.replace(/\\/g, "/"));
	if (
		CODE_EXTENSIONS.has(extname(base).toLowerCase()) &&
		!OBJECT_INFO_EXEMPT_FILES.has(base.toLowerCase()) &&
		RAW_OBJECT_INFO.re.test(newContent)
	) {
		return { id: RAW_OBJECT_INFO.id, reason: RAW_OBJECT_INFO.reason };
	}
	return null;
}

function asRecord(v: unknown): Record<string, unknown> {
	return typeof v === "object" && v !== null ? (v as Record<string, unknown>) : {};
}

