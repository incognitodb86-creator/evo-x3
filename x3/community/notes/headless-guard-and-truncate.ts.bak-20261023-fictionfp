/** forgeopen: live action log (one line per tool call, written as the call is decided). */
export function logForgeAction(toolName: string, input: unknown, v: Violation | null): void {
	try {
		const a = asRecord(input);
		let what = typeof a.command === "string" ? a.command : typeof a.path === "string" ? a.path : JSON.stringify(a);
		what = what.replace(/\r/g, "").replace(/\n/g, "\\n");
		if (what.length > 400) what = what.slice(0, 400) + "...";
		const d = new Date();
		const p2 = (n: number) => String(n).padStart(2, "0");
		const ts = `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}T${p2(d.getHours())}:${p2(d.getMinutes())}:${p2(d.getSeconds())}`;
		const f = process.env.PI_GUARD_FORGE_ACTION_LOG || "C:/AI/community/notes/forge_actions.log";
		appendFileSync(f, `${ts} LIVE ${toolName} | ${what} | ${v ? `BLOCKED (${v.id})` : "allowed"}\n`, "utf8");
	} catch {
		// logging must never affect tool execution
	}
}
