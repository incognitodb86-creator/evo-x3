		while (w.length && (BASH_PREFIX.has(w[0]) || /^[A-Za-z_]\w*=/.test(w[0]) || /^\d*[<>]/.test(w[0]))) {
			if (/^\d*[<>]+&?$/.test(w[0])) w = w.slice(2);
			else w = w.slice(1);
		}
		if (!w.length || BASH_END.has(w[0]) || w[0] === "()" ) return null;
		if (w[0] === "for" || w[0] === "case" || w[0] === "select") {
			return w[0] === "for" ? null : allowBlock("not-allowlisted", `bash ${w[0]} is not supported by the allowlist; use python for logic.`);
		}
	} else {
		if (!w.length) return null;
		const first = w[0];
		const lower = first.toLowerCase();
		if (PS_KEYWORDS.has(lower) || /^(?:\{\}|\(\)|@\(\)|@\{\}|@''@)$/.test(first)) return null;
		if (PS_RETURN.has(lower)) return w.length > 1 ? checkSegment(w.slice(1).join(" "), tool, al, state, depth) : null;
		const asg = /^\$[\w:.{}\[\]-]+\s*[+\-*/]?=(?!=)\s*([\s\S]*)$/.exec(seg);
		if (asg) return asg[1].trim() ? checkSegment(asg[1], tool, al, state, depth) : null;
		if (first === "&") {
			const target = w[1] ?? "";
			if (!target || /^[$({]/.test(target)) return allowBlock("call-variable", "& with a variable, ( ) or { } is not allowed; call the program by its literal name or path.");
			w = w.slice(1);
		} else if (first === "." || first.startsWith(". ")) {
			return allowBlock("dot-source", "dot-sourcing scripts is not allowed.");
		} else if (/^[$'"\[\d\-@(]/.test(first) || first === "$()") {
			return null; // expression statement; nested ( ) / { } / $( ) bodies are checked separately
		}
	}
	const tok = unquote(w[0]);
	if (/[$*?`]/.test(tok) || tok === "") return allowBlock("call-variable", `the command name must be literal (got ${w[0]}).`);
	let name = tok.replace(/\\/g, "/").split("/").pop()?.toLowerCase() ?? "";
	name = name.replace(/\.(?:exe|com)$/, "");
	if (tool === "powershell" && !/\.(?:exe|com)$/i.test(tok)) name = al.aliases?.[name] ?? name;   // curl.exe stays curl (PS5 maps bare curl to iwr)
