		const why = al.denylist?.commands?.[name];
		if (why) return allowBlock("hazard-command", `\`${name}\` is blocked: ${why}`);
		return (al.denylist?.argChecked ?? []).includes(name) ? checkArgs(name, w.slice(1), tool, al, state, depth) : null;
	}
	if (!(al.commands[tool] ?? []).includes(name)) return notAllowed(name, tool, al);
	return checkArgs(name, w.slice(1), tool, al, state, depth);
}

function checkAllowlistInner(command: string, tool: string, al: Allowlist, state: { cwd: string }, depth: number): Violation | null {
	if (depth > 6) return allowBlock("allowlist-parse", "command nesting is too deep to check.");
	if (tool === "powershell") {
		if (/(?<![\w-])-e(?:c|nc|ncodedcommand)(?![\w-])/i.test(command)) return allowBlock("encoded-command", "-EncodedCommand is never allowed.");
		if (/\[(?:System\.)?(?:Diagnostics\.Process|Management\.Automation\.\w+|ScriptBlock|Reflection\.\w+|Activator|Runtime\.\w+|Net\.WebClient)\]/i.test(command))
			return allowBlock("dotnet-exec", "process / scriptblock / reflection / web .NET types are not allowed.");
		if (/\.(?:Invoke|InvokeScript|Start|Kill|Delete|MoveTo|DownloadFile|DownloadString)\s*\(|::(?:Delete|Move|Start)\s*\(|\bNew-Object\b/i.test(command))
			return allowBlock("dotnet-exec", ".Invoke()/.Start()/.Kill()/.Delete()/Download*/New-Object are not allowed.");
	}
	const parsed = splitCommand(command, tool);
	if (parsed.error) return allowBlock("allowlist-parse", `could not parse the command safely (${parsed.error}). Use a simpler command.`);
	for (const seg of parsed.segments) {
		const v = checkSegment(seg, tool, al, state, depth);
		if (v) return v;
	}
	for (const nb of parsed.nested) {
		if (nb.hashtable) {
			const hp = splitCommand(nb.text, nb.tool);
			if (hp.error) return allowBlock("allowlist-parse", `could not parse the command safely (${hp.error}). Use a simpler command.`);
			for (const inner of hp.nested) {
				const v = inner.hashtable ? allowBlock("allowlist-parse", "nested @{ } hashtables are not supported.") : checkAllowlistInner(inner.text, inner.tool, al, { cwd: state.cwd }, depth + 1);
				if (v) return v;
			}
			for (const entry of hp.segments) {
				const m = /^['"]?[\w.-]+['"]?\s*=\s*([\s\S]*)$/.exec(entry);
				if (!m) return allowBlock("allowlist-parse", "unrecognised @{ } hashtable entry.");
				const v = m[1].trim() ? checkSegment(m[1], nb.tool, al, { cwd: state.cwd }, depth + 1) : null;
				if (v) return v;
			}
			continue;
		}
		const v = checkAllowlistInner(nb.text, nb.tool, al, { cwd: state.cwd }, depth + 1);
		if (v) return v;
	}
	return null;
}

/** K4: checks a bash/powershell command against the allowlist. Returns a violation or null. */
export function checkAllowlist(command: string, tool: string, cwd: string = process.cwd(), al: Allowlist = loadAllowlist()): Violation | null {
	if (al.mode === "denylist" && !isForgeSession(cwd, al)) al = { ...al, mode: "allowlist" };   // community 2026-10-23: denylist mode is Forge-only
	if (!al.tools.includes(tool)) return null;
	return checkAllowlistInner(command, tool, al, { cwd }, 0);
}

export function blockMessage(v: Violation): string {
	return (
		`Blocked by headless guard [${v.id}]: ${v.reason} ` +
		"This is a static policy for unattended runs. Do not retry the same command; use a safe alternative or note it in your final report."
	);
}

// ---------------------------------------------------------------------------------------------------------------
// Output truncation
// ---------------------------------------------------------------------------------------------------------------

function splitLines(text: string): string[] {
	const lines = text.split(/\r?\n/);
	if (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
	return lines;
}

export function exceedsLimits(text: string, opts: TruncationOptions = {}): boolean {
	const maxBytes = opts.maxBytes ?? MAX_BYTES;
	const maxLines = opts.maxLines ?? MAX_LINES;
	return Buffer.byteLength(text, "utf8") > maxBytes || splitLines(text).length > maxLines;
}

function kb(bytes: number): string {
	return `${(bytes / 1024).toFixed(1)} KB`;
}

/** Builds the model-facing replacement: notice + first N lines + last N lines + spill path. */
export function formatTruncated(text: string, fullPath: string, opts: TruncationOptions = {}): string {
	const head = opts.headLines ?? HEAD_LINES;
	const tail = opts.tailLines ?? TAIL_LINES;
	const maxChars = opts.maxLineChars ?? MAX_LINE_CHARS;
	const maxBytes = opts.maxBytes ?? MAX_BYTES;
	const maxLines = opts.maxLines ?? MAX_LINES;
	const clip = (l: string): string => (l.length > maxChars ? `${l.slice(0, maxChars)} ...[+${l.length - maxChars} chars]` : l);
	const lines = splitLines(text);
	const bytes = Buffer.byteLength(text, "utf8");

	const out: string[] = [
		`[TOOL OUTPUT TRUNCATED: ${lines.length} lines / ${kb(bytes)} exceeds the ${maxLines}-line / ${kb(maxBytes)} cap.`,
		`Full output saved to: ${fullPath}`,
		`Showing the first ${head} and last ${tail} lines. Inspect the file with targeted reads (Select-String, head, tail, read with offset/limit); never print it whole.]`,
	];
	if (lines.length <= head + tail) {
		out.push("--- all lines (long lines clipped) ---", ...lines.map(clip));
	} else {
		out.push(`--- first ${head} lines ---`, ...lines.slice(0, head).map(clip));
		out.push(`--- [${lines.length - head - tail} lines omitted] ---`);
		out.push(`--- last ${tail} lines ---`, ...lines.slice(lines.length - tail).map(clip));
	}
	return out.join("\n");
}

/** Writes the full text to `<dir>\<uuid>.txt` and returns the path. */
export function spillFull(text: string, dir: string = spillDir()): string {
	mkdirSync(dir, { recursive: true });
	const path = join(dir, `${randomUUID()}.txt`);
	writeFileSync(path, text, { encoding: "utf8" });
	return path;
}

function normalizeForCompare(p: string): string {
	const r = resolve(p);
	return process.platform === "win32" ? r.toLowerCase() : r;
}

export function isInsideDir(path: string, dir: string): boolean {
	return normalizeForCompare(path).startsWith(normalizeForCompare(dir) + sep);
}

