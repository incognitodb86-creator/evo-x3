		if (SECRET_CMD.test(cmd)) return { id: "secret", reason: SECRET_REASON };
		for (const tok of cmd.split(/[\s"'`;|&<>(),={}\[\]]+/)) if (tok && secretPathHit(tok, cwd)) return { id: "secret", reason: SECRET_REASON };
		return null;
	}
	for (const k of ["path", "file", "glob"]) {
		const v = args[k];
		if (typeof v === "string" && v && secretPathHit(v, cwd)) return { id: "secret", reason: SECRET_REASON };
	}
	return null;
}
export function isForgeOpen(opts: { headless?: boolean; cwd?: string }): boolean {
	if (!opts.headless || process.env.PI_GUARD_FORGE_OPEN === "0") return false;
	let al: Allowlist | undefined;
	try { al = loadAllowlist(); } catch { return false; }
	return al.forgeOpen !== false && isForgeSession(opts.cwd || process.cwd(), al);
}

export interface EvalOptions {
	/** true = headless run (ctx.hasUI === false): the K4 command allowlist applies. */
	headless?: boolean;
	cwd?: string;
}

/** Evaluates a tool call (name + input) against the denylist, then (headless) the K4 command allowlist. */
export function evaluateToolCall(toolName: string, input: unknown, opts: EvalOptions = {}): Violation | null {
	const args = asRecord(input);
	if (isForgeOpen(opts)) return forgeOpenCheck(toolName, args, opts.cwd || process.cwd()); // forgeopen: secrets only (+ GPU lock, fiction lock)
	if (toolName === "bash" || toolName === "powershell") {
		if (typeof args.command !== "string") return null;
		let al: Allowlist | undefined;
		let alErr: unknown;
		try {
			al = loadAllowlist();
		} catch (error) {
			alErr = error;
		}
		const forge = !!opts.headless && !!al && isForgeSession(opts.cwd || process.cwd(), al);
		const denied = checkCommand(forge ? maskAllowedLocal(args.command) : args.command);
		if (denied) return denied;
		if (!al) {
			if (!opts.headless) return null; // UI runs keep working without the file; headless fails closed
			return { id: "allowlist-missing", reason: `the command allowlist (${ALLOWLIST_FILE}) could not be loaded (${String(alErr)}); all shell commands are blocked until the supervisor fixes it.` };
		}
		if (forge && COMFY_STOP.test(args.command) && renderRunning()) return { id: "comfy-restart-busy", reason: COMFY_BUSY_REASON };
		if (!opts.headless && !al.applyInUI) return null;
		if (opts.headless && isForgeSession(opts.cwd || process.cwd(), al)) {
			if (FORGE_FINANCE.test(args.command)) return { id: "finance-paths", reason: FINANCE_REASON };
			const pkg = checkPackageInstall(args.command);
			if (pkg) return pkg;
		}
		return checkAllowlist(args.command, toolName, opts.cwd || process.cwd(), al);
	}
	if (opts.headless && /^(?:read|grep|find|ls|edit|write)$/.test(toolName)) {
		const cwd = opts.cwd || process.cwd();
		let al: Allowlist | undefined;
		try { al = loadAllowlist(); } catch { al = undefined; }
		if (isForgeSession(cwd, al)) {
			const raw = String(args.path ?? args.file ?? "");
			if (raw) {
				const abs = normPath(raw, cwd);
				if (FORGE_FINANCE_PATH.test(abs)) return { id: "finance-paths", reason: FINANCE_REASON };
				if (FORGE_SECRET_PATH.test(abs)) return { id: "secret-path", reason: "secrets (.env*, auth.json, keys, rclone config, session logs) are never opened by Forge." };
				// Reads widened to C:/AI + custom_nodes on 2026-10-23; writes did not. pi-permissions' older edit/write allows for C:/AI/director/*
				// (other sessions) became reachable through the wider external_directory, so Forge's file-tool write roots are pinned here.
				if ((toolName === "edit" || toolName === "write") && (/^c:\/ai(?:\/|$)/.test(abs) || /^c:\/users\/derek\/hardcorensfw-testruntime(?:\/|$)/.test(abs))) {
					const okRoots = ["c:/ai/community/", "c:/ai/launchers/", "c:/ai/security/skillspector/"];
					if (!okRoots.some((r) => abs.startsWith(r)) && abs !== "c:/ai/organize_plan_2026-10-21.md")
						return { id: "forge-write-scope", reason: "Forge writes with edit/write only under C:/AI/community (plus Launchers / skillspector); C:/AI is read-only otherwise and ComfyUI files are never edited." };
				}
			}
		}
	}
	if (toolName === "write") {
		return checkFileWrite(String(args.path ?? ""), typeof args.content === "string" ? args.content : "");
	}
	if (toolName === "edit") {
		const edits = Array.isArray(args.edits) ? args.edits : [];
		const newText = edits.map((e) => String(asRecord(e).newText ?? "")).join("\n");
		return checkFileWrite(String(args.path ?? ""), newText);
	}
	return null;
}

