const NON_INTERACTIVE_ENV: Record<string, string> = {
	GIT_TERMINAL_PROMPT: "0",
	GIT_PAGER: "cat",
	PAGER: "cat",
	PIP_NO_INPUT: "1",
	PIP_DISABLE_PIP_VERSION_CHECK: "1",
};

type PermissionSystemApi = {
	getYoloMode(): boolean;
	setYoloMode(enabled: boolean, options?: { persist?: boolean; source?: string }): { yoloMode: boolean; error?: string };
};

function logEvent(event: Record<string, unknown>): void {
	try {
		const dir = spillDir();
		mkdirSync(dir, { recursive: true });
		appendFileSync(join(dir, "guard-events.jsonl"), `${JSON.stringify({ ts: new Date().toISOString(), ...event })}\n`, "utf8");
	} catch {
		// logging must never affect tool execution
	}
}

function applyHeadlessDefaults(hasUI: boolean): void {
	if (hasUI) return;
	for (const [k, v] of Object.entries(NON_INTERACTIVE_ENV)) {
		if (process.env[k] === undefined) process.env[k] = v;
	}
	if (process.env.PI_HEADLESS_GUARD_AUTO_APPROVE === "0") return;
	const api = (globalThis as { __piPermissionSystem?: PermissionSystemApi }).__piPermissionSystem;
	if (!api || api.getYoloMode()) return;
	const res = api.setYoloMode(true, { persist: false, source: "headless-guard-and-truncate" });
	logEvent({ kind: "auto-approve", yolo: res.yoloMode, error: res.error ?? null });
}

