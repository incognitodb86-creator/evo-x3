// ---------------------------------------------------------------------------------------------------------------

export default function headlessGuardAndTruncate(pi: ExtensionAPI): void {
	pi.on("session_start", async (_event, ctx) => {
		applyHeadlessDefaults(ctx.hasUI);
	});

	pi.on("before_agent_start", async (_event, ctx) => {
		applyHeadlessDefaults(ctx.hasUI);
		return undefined;
	});

	pi.on("tool_call", async (event, ctx) => {
		try {
			applyHeadlessDefaults(ctx.hasUI);
			const violation = evaluateToolCall(event.toolName, event.input, { headless: ctx.hasUI === false, cwd: ctx.cwd });
			if (isForgeOpen({ headless: ctx.hasUI === false, cwd: ctx.cwd })) logForgeAction(event.toolName, event.input, violation);
			if (!violation) return undefined;
			logEvent({ kind: "block", tool: event.toolName, rule: violation.id });
			return { block: true, reason: blockMessage(violation) };
		} catch (error) {
			// Fail closed: Pi would block on a handler failure anyway; give the model a readable reason.
			logEvent({ kind: "guard-error", tool: event.toolName, error: String(error) });
			return { block: true, reason: "Blocked by headless guard: internal error while checking this call. Retry with a simpler command." };
		}
	});

	pi.on("tool_result", async (event) => {
		try {
			const parts = event.content ?? [];
			const texts = parts.filter((p) => p.type === "text") as { type: "text"; text: string }[];
			if (texts.length === 0) return undefined;
			const text = texts.map((p) => p.text).join("\n");
			if (!exceedsLimits(text)) return undefined;

			const inputPath = asRecord(event.input).path;
			const dir = spillDir();
			const rereadingSpill = event.toolName === "read" && typeof inputPath === "string" && isInsideDir(inputPath, dir);
			const fullPath = rereadingSpill ? resolve(inputPath as string) : spillFull(text, dir);
			const shaped = formatTruncated(text, fullPath);
			logEvent({ kind: "truncate", tool: event.toolName, bytes: Buffer.byteLength(text, "utf8"), lines: splitLines(text).length, path: fullPath });
			const rest = parts.filter((p) => p.type !== "text");
			return { content: [{ type: "text" as const, text: shaped }, ...rest] };
		} catch (error) {
			logEvent({ kind: "truncate-error", tool: event.toolName, error: String(error) });
			return undefined;
		}
	});
}
