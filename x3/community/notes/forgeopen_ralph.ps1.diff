+    $txt = (@($m.content) | ForEach-Object { "$($_.text)" }) -join ' '
+    $c = $calls["$($m.toolCallId)"]; $a = if($c){ $c.arguments } else { $null }
+    $what = if($a -and $a.command){ "$($a.command)" } elseif($a -and $a.path){ "$($a.path)" } elseif($a){ ($a | ConvertTo-Json -Compress -Depth 3) } else { '' }
