+function PassLog($path, $n){
+  # forgeopen: one line per tool call -> forge_actions.log; tool-result denies -> denies.log. Returns the deny count (tool results only).
+  $calls = @{}; $act = @(); $den = @(); $k = 0
+  foreach($line in [IO.File]::ReadLines($path)){
+    if($line -notmatch '"toolCall"|"toolResult"'){ continue }
+    try { $e = $line | ConvertFrom-Json } catch { continue }
+    $m = $e.message; if(-not $m){ continue }
+    if($m.role -eq 'assistant'){ foreach($c in @($m.content)){ if($c.type -eq 'toolCall'){ $calls["$($c.id)"] = $c } }; continue }
