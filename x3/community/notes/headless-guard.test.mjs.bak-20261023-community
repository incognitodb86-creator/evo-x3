function fakePi() {
	const handlers = {};
	return {
		handlers,
		on(name, fn) {
			(handlers[name] ??= []).push(fn);
			return () => {};
		},
	};
}

test("handlers: tool_call blocks with a reason and passes allowed calls", async () => {
	const pi = fakePi();
	ext.default(pi);
	const ctx = { hasUI: true };
	const deny = await pi.handlers.tool_call[0]({ toolName: "bash", input: { command: "rm -rf /" } }, ctx);
	assert.equal(deny.block, true);
	assert.match(deny.reason, /recursive-rm/);
	const ok = await pi.handlers.tool_call[0]({ toolName: "bash", input: { command: "git status" } }, ctx);
	assert.equal(ok, undefined);
});

test("handlers: tool_result truncates, keeps images, spills file", async () => {
	const pi = fakePi();
	ext.default(pi);
	const big = Array.from({ length: 3000 }, (_, i) => `row ${i}`).join("\n");
	const image = { type: "image", data: "AAAA", mimeType: "image/png" };
	const res = await pi.handlers.tool_result[0]({ toolName: "bash", input: {}, content: [{ type: "text", text: big }, image] }, {});
	assert.ok(res.content[0].text.includes("TOOL OUTPUT TRUNCATED"));
	assert.deepEqual(res.content[1], image);
	const path = /Full output saved to: (.+)/.exec(res.content[0].text)[1].trim();
	assert.ok(existsSync(path));
	assert.equal(readFileSync(path, "utf8"), big);
	assert.equal(await pi.handlers.tool_result[0]({ toolName: "bash", input: {}, content: [{ type: "text", text: "small" }] }, {}), undefined);
});

test("handlers: re-reading a spill file does not create another spill", async () => {
	const pi = fakePi();
	ext.default(pi);
	const spilled = ext.spillFull("q\n".repeat(5000));
	const res = await pi.handlers.tool_result[0]({ toolName: "read", input: { path: spilled }, content: [{ type: "text", text: "q\n".repeat(5000) }] }, {});
	assert.ok(res.content[0].text.includes(spilled));
});

test("handlers: headless run enables non-persistent auto-approve and env defaults; UI run does not", async () => {
	const calls = [];
	let yolo = false;
	globalThis.__piPermissionSystem = {
		getYoloMode: () => yolo,
		setYoloMode: (enabled, options) => {
			yolo = enabled;
			calls.push({ enabled, options });
			return { yoloMode: enabled };
		},
	};
	delete process.env.GIT_TERMINAL_PROMPT;
	const pi = fakePi();
	ext.default(pi);
	await pi.handlers.session_start[0]({}, { hasUI: true });
	assert.equal(calls.length, 0);
	assert.equal(process.env.GIT_TERMINAL_PROMPT, undefined);
	await pi.handlers.session_start[0]({}, { hasUI: false });
	assert.equal(calls.length, 1);
	assert.equal(calls[0].enabled, true);
	assert.equal(calls[0].options.persist, false);
	assert.equal(process.env.GIT_TERMINAL_PROMPT, "0");
	await pi.handlers.tool_call[0]({ toolName: "read", input: {} }, { hasUI: false });
	assert.equal(calls.length, 1, "already on: no second call");
	delete globalThis.__piPermissionSystem;
});

